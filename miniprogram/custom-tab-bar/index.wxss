.tb {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--sf, #fffdf8);
  border-top: 2rpx solid var(--ln, #e7dfd1);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 50;
}

.tb__inner {
  display: flex;
  align-items: center;
  height: 116rpx;
}

.tb__i {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--mu, #7c7367);
  height: 100%;
}

.tb__txt {
  line-height: 1.15;
}

.tb__i--on {
  color: var(--ink, #1f1b16);
  font-weight: 700;
}

.tb__i--on.tb__i--today {
  color: var(--ac, #c2410c);
}

.tb__i--on.tb__i--goods {
  color: var(--ok, #355a35);
}

.tb__i--on.tb__i--debts {
  color: var(--wn, #94560a);
}

.tb__i--on.tb__i--mine {
  color: var(--vl, #4a3d73);
}

.tb__ico {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.tb__ico--today {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjN2M3MzY3IiBzdHJva2Utd2lkdGg9IjEuOSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48Y2lyY2xlIGN4PSIxMiIgY3k9IjEyIiByPSI4LjUiLz48cGF0aCBkPSJNMTIgNy41VjEybDMgMiIvPjwvc3ZnPg==");
}

.tb__ico--today.tb__ico--on {
  background-image: url("data:image/svg+xml;base64,");
}

.tb__ico--goods {
  background-image: url("data:image/svg+xml;base64,");
}

.tb__ico--goods.tb__ico--on {
  background-image: url("data:image/svg+xml;base64,");
}

.tb__ico--debts {
  background-image: url("data:image/svg+xml;base64,");
}

.tb__ico--debts.tb__ico--on {
  background-image: url("data:image/svg+xml;base64,");
}

.tb__ico--mine {
  background-image: url("data:image/svg+xml;base64,");
}

.tb__ico--mine.tb__ico--on {
  background-image: url("data:image/svg+xml;base64,");
}

/* 中间留出说话键的位置 */
.tb__gap {
  width: 168rpx;
  flex-shrink: 0;
}

.tb__mic {
  position: absolute;
  left: 50%;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: var(--ac, #c2410c);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-shadow: 0 0 0 20rpx #f3d2c0, 0 16rpx 32rpx -12rpx rgba(194, 65, 12, 0.6);
}

.tb__mic-ico {
  width: 48rpx;
  height: 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-image: url("data:image/svg+xml;base64,");
}

.tb__mic-t {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.1;
}

/* 电脑版微信大屏（>=768px）：收拢成居中悬浮 Dock，不横跨整个宽屏 */
@media (min-width: 768px) {
  .tb {
    max-width: 560px;
    margin: 0 auto;
    left: 0;
    right: 0;
    bottom: 14px;
    border: 1px solid var(--ln, #e7dfd1);
    border-radius: 18px;
    box-shadow: 0 10px 28px rgba(31, 27, 22, 0.12);
    padding-bottom: 0;
  }

  .tb__inner {
    height: 60px;
  }

  .tb__i {
    gap: 3px;
    font-size: 12px;
    cursor: pointer;
  }

  .tb__ico {
    width: 20px;
    height: 20px;
  }

  .tb__gap {
    width: 84px;
  }

  .tb__mic {
    width: 60px;
    height: 60px;
    bottom: 14px;
    gap: 2px;
    box-shadow: 0 0 0 8px #f3d2c0, 0 8px 20px -6px rgba(194, 65, 12, 0.55);
    cursor: pointer;
  }

  .tb__mic-ico {
    width: 22px;
    height: 22px;
  }

  .tb__mic-t {
    font-size: 11px;
  }
}
