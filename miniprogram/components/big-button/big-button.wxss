/* 语音大按钮（方案 A）：微信绿实心圆，热区 200rpx（≈100px），单手拇指可及 */
.wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--s-1) 0;
}

.button {
  width: 200rpx;
  height: 200rpx;
  /* 热区下限用 px 表达（200rpx 在不同屏换算不同，这里给一个绝对兜底 100px ≥ 88px 的 PRD 下限） */
  min-width: 100px;
  min-height: 100px;
  border-radius: 50%;
  background: var(--c-brand);
  color: var(--c-white);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.24);
  transition: transform 120ms ease, background 120ms ease;
}

.button:active {
  transform: scale(0.97);
}

.button--recording {
  background: var(--c-danger);
  box-shadow: 0 8rpx 24rpx rgba(217, 48, 37, 0.28);
}

.button--disabled {
  background: #d7dbe0;
  color: var(--c-ink-3);
  box-shadow: none;
}

.button__icon {
  font-size: 56rpx;
  line-height: 1;
}

.button__text {
  margin-top: var(--s-1);
  font-size: var(--f-body);
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 录音中的实时反馈：时长 + 柱状（视觉占位，不参与判定） */
.meter {
  margin-top: var(--s-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 420rpx;
}

.meter__time {
  font-size: var(--f-body);
  color: var(--c-brand-dark);
  font-variant-numeric: tabular-nums;
}

.meter__time--warn {
  color: var(--c-danger);
}

.meter__bars {
  margin-top: var(--s-1);
  height: 56rpx;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.meter__bar {
  width: 14rpx;
  border-radius: 7rpx;
  background: var(--c-brand);
  opacity: 0.8;
  min-height: 6rpx;
}

.meter__hint {
  margin-top: var(--s-1);
  font-size: 22rpx;
  color: var(--c-danger);
}

.mode {
  margin-top: var(--s-1);
  font-size: var(--f-small);
  color: var(--c-ink-3);
  padding: var(--s-1) var(--s-3);
}
