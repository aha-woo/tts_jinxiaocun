/* 左导航（方案 A）：白底，选中项绿底绿字，禁用项锁定标记 */
.nav {
  display: flex;
  flex-direction: column;
  width: 240rpx;
  flex-shrink: 0;
  background: var(--c-white);
  border-right: 1rpx solid var(--c-line);
  padding: var(--s-2) 0;
}

/* 窄屏 → 横向标签，入口一个不少 */
.nav--narrow {
  width: 100%;
  flex-direction: row;
  overflow-x: auto;
  border-right: none;
  border-bottom: 1rpx solid var(--c-line);
  padding: var(--s-1) var(--s-2);
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-2) var(--s-3);
  font-size: var(--f-small);
  color: var(--c-ink-2);
}

.item__lead {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.nav-ico {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

