/* 左导航（方案 A）：白底，选中项绿底绿字，禁用项锁定标记 */
.nav {
  display: flex;
  flex-direction: column;
  width: 240rpx;
  flex-shrink: 0;
  background: var(--c-white);
  border-right: 1rpx solid var(--c-line);
  padding: var(--s-2) 0;
}

/* 窄屏 → 横向标签，入口一个不少 */
.nav--narrow {
  width: 100%;
  flex-direction: row;
  overflow-x: auto;
  border-right: none;
  border-bottom: 1rpx solid var(--c-line);
  padding: var(--s-1) var(--s-2);
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--s-2) var(--s-3);
  font-size: var(--f-small);
  color: var(--c-ink-2);
}

.nav--narrow .item {
  padding: var(--s-2) var(--s-3);
  white-space: nowrap;
}

.item--active {
  color: var(--c-brand-dark);
  font-weight: 700;
  background: var(--c-brand-soft);
}

.item--locked {
  color: var(--c-ink-3);
}

.item__lock {
  font-size: 18rpx;
  color: var(--c-ink-3);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-pill);
  padding: 2rpx 10rpx;
  margin-left: var(--s-1);
}

/* 电脑版微信大屏（>=768px）：切为清晰 px 尺度，保留上方窄屏回落契约不变 */
@media (min-width: 768px) {
  .nav {
    width: 220px;
    padding: 16px 10px;
    gap: 4px;
  }

  .item {
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 14px;
    cursor: pointer;
  }

  .item:hover {
    background: #faf6ee;
  }

  .item--active:hover {
    background: var(--c-brand-soft);
  }

  .item__lock {
    font-size: 11px;
    padding: 1px 8px;
    margin-left: 6px;
  }
}
