.kb {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.kb__section {
  margin-bottom: 24rpx;
}

.kb__label {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.kb__dirs {
  display: flex;
}

.dir {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  background: #f1f3f5;
  color: #4b5563;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.dir:last-child {
  margin-right: 0;
}

.dir--active {
  background: #1f6feb;
  color: #fff;
  font-weight: 600;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #f1f3f5;
  font-size: 26rpx;
  color: #1f2328;
  margin: 0 16rpx 16rpx 0;
  /* 热区下限：拇指可点 */
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.chip--active {
  background: #e8f0ff;
  color: #1554b5;
  font-weight: 600;
}

.chip--empty {
  color: #9aa4ae;
}

.inputs {
  display: flex;
}

.input {
  flex: 1;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-right: 16rpx;
}

.input:last-child {
  margin-right: 0;
}

.input--active {
  border-color: #1f6feb;
  background: #fff;
}

.input__label {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
}

.input__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2328;
  font-variant-numeric: tabular-nums;
}

.keys {
  display: flex;
  flex-wrap: wrap;
}

.key {
  width: calc((100% - 32rpx) / 3);
  margin: 0 16rpx 16rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 36rpx;
  color: #1f2328;
}

.key:nth-child(3n) {
  margin-right: 0;
}

.key--fn {
  background: #eef1f4;
  color: #4b5563;
}

.submit {
  margin-top: 8rpx;
  background: #1f6feb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  height: 96rpx;
  line-height: 96rpx;
}

.tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa4ae;
  text-align: center;
}
