/* 数字键盘（方向 A 暖纸账本） */
.kb {
  background: transparent;
  padding: 0;
  margin: 0;
}

.kb__section {
  margin-bottom: 22rpx;
}

.kb__label {
  font-size: 24rpx;
  color: var(--mu, #7c7367);
  margin-bottom: 10rpx;
}

/* 方向：分段控件（进货 / 卖货） */
.seg {
  display: flex;
  background: #eae3d5;
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg__item {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6b6257;
}

.seg__item--active {
  background: var(--sf, #fffdf8);
  color: var(--ink, #1f1b16);
  font-weight: 700;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
}

/* 商品 chips：暖纸轻胶囊 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--bg, #f5f1e8);
  border: 2rpx solid var(--ln, #e7dfd1);
  font-size: 24rpx;
  color: var(--ink, #1f1b16);
}

.chip--active {
  background: var(--acs, #fbe6da);
  border-color: #eabaa0;
  color: var(--act, #a8380a);
  font-weight: 700;
}

.chip--empty {
  color: var(--mu, #7c7367);
  font-size: 24rpx;
}

/* 数量 / 单价：两栏等宽，点哪栏写哪栏 */
.inputs {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.input {
  flex: 1;
  background: var(--bg, #f5f1e8);
  border: 2rpx solid var(--ln, #e7dfd1);
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
}

.input--active {
  border-color: var(--ac, #c2410c);
  background: var(--sf, #fffdf8);
}

.input__label {
  display: block;
  font-size: 22rpx;
  color: var(--mu, #7c7367);
}

.input__value {
  display: block;
  margin-top: 4rpx;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink, #1f1b16);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

/* 键盘：3 列 grid */
.keys {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.ui-key {
  height: 92rpx;
  border-radius: 18rpx;
  background: var(--bg, #f5f1e8);
  border: 2rpx solid var(--ln, #e7dfd1);
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink, #1f1b16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ui-key:active {
  background: var(--acs, #fbe6da);
}

.ui-key--fn {
  background: #efe9dc;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 28rpx;
  color: var(--mu, #7c7367);
}

.ico-backspace {
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  background-image: url("data:image/svg+xml;base64,");
}

.kb__submit {
  width: 100%;
  margin: 22rpx 0 0;
  min-height: 96rpx;
  border-radius: 22rpx;
  background: var(--ac, #c2410c);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  padding: 0;
}

.kb__submit::after {
  border: none;
}

.kb__submit:active {
  background: var(--act, #a8380a);
}

.kb__tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--mu, #7c7367);
  text-align: center;
  line-height: 1.5;
}
