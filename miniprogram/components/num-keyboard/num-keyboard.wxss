/* 数字键盘（方案 A）：白底、绿主色、单格 104rpx、键位对齐用 grid 而不是 nth-child */
.kb {
  background: var(--c-white);
  border-radius: var(--r-card);
  padding: var(--s-3);
  margin-bottom: var(--s-3);
}

.kb__section {
  margin-bottom: var(--s-3);
}

.kb__label {
  font-size: var(--f-small);
  color: var(--c-ink-3);
  margin-bottom: var(--s-1);
}

/* 方向：分段控件（进货 / 卖货） */
.seg {
  display: flex;
  background: #f1f3f5;
  border-radius: var(--r-btn);
  padding: 6rpx;
}

.seg__item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: var(--f-body);
  color: var(--c-ink-2);
}

.seg__item--active {
  background: var(--c-white);
  color: var(--c-brand-dark);
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.08);
}

/* 商品 chips：胶囊、44px 高，选中用浅绿底 */
.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 var(--s-3);
  margin: 0 var(--s-2) var(--s-2) 0;
  border-radius: var(--r-pill);
  background: #f1f3f5;
  font-size: var(--f-body);
  color: var(--c-ink);
}

.chip--active {
  background: var(--c-brand-soft);
  color: var(--c-brand-dark);
  font-weight: 700;
}

.chip--empty {
  color: var(--c-ink-3);
  font-size: var(--f-small);
}

/* 数量 / 单价：两栏等宽，点哪栏写哪栏 */
.inputs {
  display: flex;
  margin-top: var(--s-3);
}

.input {
  flex: 1;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: var(--r-btn);
  padding: var(--s-2) var(--s-3);
  margin-right: var(--s-2);
}

.input:last-child {
  margin-right: 0;
}

.input--active {
  border-color: var(--c-brand);
  background: var(--c-white);
}

.input__label {
  display: block;
  font-size: 22rpx;
  color: var(--c-ink-3);
}

.input__value {
  display: block;
  margin-top: 2rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

/* 键盘：3 列 grid，间距统一，不再用 nth-child 补右边距 */
.keys {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--s-2);
  margin-top: var(--s-2);
}

.kb__submit {
  margin-top: var(--s-3);
}

.kb__tip {
  margin-top: var(--s-1);
  font-size: 22rpx;
  color: var(--c-ink-3);
  text-align: center;
  line-height: 1.5;
}
