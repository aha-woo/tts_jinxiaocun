.table {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.table__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #eef1f4;
}

.table__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2328;
}

.row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f4f6f8;
}

.row--highlight {
  background: #fff8e6;
  border-radius: 12rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.row__left {
  display: flex;
  align-items: center;
}

.row__label {
  font-size: 28rpx;
  color: #1f2328;
}

.row__code {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #9aa4ae;
}

.row__value {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2328;
  margin-right: 12rpx;
}

.value--pending {
  color: #b42318;
  font-weight: 500;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.tag--asr {
  color: #1554b5;
  background: #e8f0ff;
}

.tag--default {
  color: #6b7280;
  background: #f1f3f5;
}

.tag--computed {
  color: #7a4d00;
  background: #fff3d6;
}

.tag--alias {
  color: #0f7b6c;
  background: #e3f5f1;
}

.tag--pending {
  color: #b42318;
  background: #fde8e8;
}

.row__trace {
  margin-top: 6rpx;
}

.trace {
  font-size: 22rpx;
  color: #7a4d00;
}

.table__empty {
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #9aa4ae;
  text-align: center;
}
