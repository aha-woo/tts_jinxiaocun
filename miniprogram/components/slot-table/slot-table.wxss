/* 槽位明细（**只在「解析明细（开发用）」里出现**，不面向终端用户） */
.table {
  background: var(--c-white);
  border-radius: var(--r-card);
  padding: var(--s-2) 0;
}

.table__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--s-1);
  border-bottom: 1rpx solid var(--c-line);
}

.table__title {
  font-size: var(--f-small);
  font-weight: 600;
  color: var(--c-ink-2);
}

.row {
  padding: var(--s-2) 0;
  border-bottom: 1rpx solid var(--c-line);
}

.row--highlight {
  background: var(--c-warn-bg);
  border-radius: var(--r-btn);
  padding-left: var(--s-2);
  padding-right: var(--s-2);
}

.row__left {
  display: flex;
  align-items: center;
}

.row__label {
  font-size: var(--f-small);
  color: var(--c-ink-2);
}

.row__code {
  margin-left: var(--s-1);
  font-size: 20rpx;
  color: var(--c-ink-3);
}

.row__value {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.value {
  font-size: var(--f-small);
  font-weight: 600;
  color: var(--c-ink);
  margin-right: var(--s-1);
}

.value--pending {
  color: var(--c-danger);
  font-weight: 500;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx var(--s-1);
  border-radius: var(--r-pill);
}

.tag--asr {
  color: var(--c-brand-dark);
  background: var(--c-brand-soft);
}

.tag--default {
  color: var(--c-ink-3);
  background: #f1f3f5;
}

.tag--computed {
  color: var(--c-warn-ink);
  background: var(--c-warn-bg);
}

.tag--alias {
  color: var(--c-brand-dark);
  background: var(--c-brand-soft);
}

.tag--pending {
  color: var(--c-danger);
  background: var(--c-danger-soft);
}

.row__trace {
  margin-top: 4rpx;
}

.trace {
  font-size: 22rpx;
  color: var(--c-warn-ink);
}

.table__empty {
  padding: var(--s-2) 0;
  font-size: var(--f-small);
  color: var(--c-ink-3);
  text-align: center;
}
