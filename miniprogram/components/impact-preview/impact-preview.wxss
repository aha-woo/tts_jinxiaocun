/* 影响预览（方案 A）：只读预演，白底 + 绿色「变之后」 */
.impact {
  background: var(--c-white);
  border-radius: var(--r-card);
  padding: var(--s-3) var(--s-4);
  margin-bottom: var(--s-2);
  border: 1rpx solid var(--c-line);
}

.impact__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--s-1);
}

.impact__title {
  font-size: var(--f-body);
  font-weight: 600;
  color: var(--c-ink);
}

.impact__version {
  font-size: var(--f-small);
  color: var(--c-ink-3);
}

.impact__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-bottom: 1rpx solid var(--c-line);
}

.impact__row:last-child {
  border-bottom: none;
}

.impact__row--warn {
  background: var(--c-danger-soft);
  border-radius: var(--r-btn);
  padding: 0 var(--s-2);
}

.impact__label {
  flex: 1;
  min-width: 0;
  font-size: var(--f-small);
  color: var(--c-ink-2);
}

.impact__delta {
  display: flex;
  align-items: center;
}

.impact__before {
  font-size: var(--f-small);
  color: var(--c-ink-3);
  font-variant-numeric: tabular-nums;
}

.impact__arrow {
  margin: 0 var(--s-1);
  color: var(--c-ink-3);
}

.impact__after {
  font-size: var(--f-body);
  font-weight: 700;
  color: var(--c-brand-dark);
  font-variant-numeric: tabular-nums;
}

.impact__after--warn {
  color: var(--c-danger);
}

.impact__note {
  margin-top: var(--s-1);
  font-size: 22rpx;
  color: var(--c-ink-3);
}

.impact__empty {
  padding: var(--s-3) 0;
  font-size: var(--f-small);
  color: var(--c-ink-3);
  text-align: center;
}
