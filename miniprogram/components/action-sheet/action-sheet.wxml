<!-- 暖纸风格底部操作菜单（替代系统冷白 wx.showActionSheet） -->
<view wx:if="{{visible}}" class="as-mask" bindtap="onMaskTap">
  <view class="as-sheet" catchtap="noop">
    <view class="as-grab"></view>

    <view wx:if="{{title || subtitle}}" class="as-head">
      <text wx:if="{{title}}" class="as-title">{{title}}</text>
      <text wx:if="{{subtitle}}" class="as-sub">{{subtitle}}</text>
    </view>

    <view class="as-list">
      <view
        wx:for="{{actions}}"
        wx:key="key"
        class="as-item {{item.tone === 'primary' ? 'as-item--primary' : item.tone === 'danger' ? 'as-item--danger' : ''}}"
        data-index="{{index}}"
        data-key="{{item.key}}"
        bindtap="onPick"
      >
        <view class="as-item__main">
          <text class="as-item__label">{{item.label}}</text>
          <text wx:if="{{item.desc}}" class="as-item__desc">{{item.desc}}</text>
        </view>
        <text class="as-item__go">›</text>
      </view>
    </view>

    <view class="as-cancel" bindtap="onCancel">{{cancelText || '取消'}}</view>
  </view>
</view>
