/* 暖纸账本风格底部操作弹窗 */
.as-mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  background: rgba(31, 27, 22, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.as-sheet {
  width: 100%;
  background: var(--sf, #fffdf8);
  border-top: 2rpx solid var(--ln, #e7dfd1);
  border-radius: 36rpx 36rpx 0 0;
  padding: 18rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -16rpx 40rpx rgba(31, 27, 22, 0.14);
}

.as-grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #dfd6c7;
  margin: 0 auto 20rpx;
}

.as-head {
  padding: 4rpx 8rpx 20rpx;
  border-bottom: 2rpx solid var(--ln, #e7dfd1);
  margin-bottom: 18rpx;
}

.as-title {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink, #1f1b16);
  line-height: 1.3;
}

.as-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mu, #7c7367);
}

.as-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  max-height: 56vh;
  overflow-y: auto;
}

.as-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 98rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: var(--bg, #f5f1e8);
  border: 2rpx solid var(--ln, #e7dfd1);
}

.as-item:active {
  background: #ede5d5;
}

.as-item--primary {
  background: var(--acs, #fbe6da);
  border-color: #ebc2ad;
}

.as-item--primary .as-item__label,
.as-item--primary .as-item__go {
  color: var(--act, #a8380a);
}

.as-item--danger {
  background: var(--dgrb, #f3e3e0);
  border-color: #e3bfb8;
}

.as-item--danger .as-item__label,
.as-item--danger .as-item__go {
  color: var(--dgr, #8a3b2e);
}

.as-item__main {
  flex: 1;
  min-width: 0;
}

.as-item__label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink, #1f1b16);
}

.as-item__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--mu, #7c7367);
}

.as-item__go {
  font-size: 34rpx;
  color: var(--mu, #7c7367);
  flex-shrink: 0;
}

.as-cancel {
  margin-top: 20rpx;
  height: 92rpx;
  border-radius: 22rpx;
  background: #efe9dc;
  color: var(--mu, #7c7367);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.as-cancel:active {
  background: #e5ddd0;
}

/* 电脑版微信大屏（>=768px）：居中轻量浮层卡片 */
@media (min-width: 768px) {
  .as-mask {
    align-items: center;
  }

  .as-sheet {
    width: 440px;
    max-width: 92vw;
    border: 1px solid var(--ln, #e7dfd1);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 18px 48px rgba(31, 27, 22, 0.22);
  }

  .as-grab {
    display: none;
  }

  .as-head {
    padding: 0 2px 14px;
    border-bottom-width: 1px;
    margin-bottom: 14px;
  }

  .as-title {
    font-size: 18px;
  }

  .as-sub {
    font-size: 13px;
    margin-top: 4px;
  }

  .as-list {
    gap: 10px;
  }

  .as-item {
    min-height: 48px;
    padding: 12px 16px;
    border-radius: 12px;
    border-width: 1px;
    cursor: pointer;
  }

  .as-item__label {
    font-size: 14px;
  }

  .as-item__desc {
    font-size: 12px;
  }

  .as-item__go {
    font-size: 18px;
  }

  .as-cancel {
    margin-top: 14px;
    height: 42px;
    border-radius: 12px;
    font-size: 14px;
    cursor: pointer;
  }
}
