<!-- 查询（只读）：不建卡、不扣次 -->
<view class="page">
  <view class="tabs">
    <view class="tab {{kind === 'stock' ? 'tab--active' : ''}}" data-kind="stock" bindtap="onTab">库存</view>
    <view class="tab {{kind === 'debt' ? 'tab--active' : ''}}" data-kind="debt" bindtap="onTab">欠款</view>
    <view class="tab {{kind === 'docs' ? 'tab--active' : ''}}" data-kind="docs" bindtap="onTab">流水</view>
  </view>

  <view class="search">
    <input class="search__input" placeholder="商品名 / 客户名（可留空）" value="{{keyword}}" bindinput="onKeyword" />
    <button class="ui-btn ui-btn--primary search__btn" bindtap="reload">查</button>
  </view>

  <view class="loading" wx:if="{{loading}}">查询中…</view>
  <view class="empty" wx:if="{{!loading && rows.length === 0 && !errorText}}">没有数据</view>

  <view wx:for="{{rows}}" wx:key="text" class="row">{{item.text}}</view>

  <view class="error" wx:if="{{errorText}}">{{errorText}}</view>
  <view class="hint">查询是只读的：不建卡、不写库、不扣次数。</view>
</view>
