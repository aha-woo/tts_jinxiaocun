/* 查询（方案 A）：分段标签 + 搜索行 + 结果卡片，只读页不放大按钮 */
.page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: var(--s-3);
  box-sizing: border-box;
}

.tabs {
  display: flex;
  background: #f1f3f5;
  border-radius: var(--r-btn);
  padding: 6rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: var(--f-body);
  color: var(--c-ink-2);
}

.tab--active {
  background: var(--c-white);
  color: var(--c-brand-dark);
  font-weight: 700;
  box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.08);
}

.search {
  display: flex;
  align-items: center;
  margin: var(--s-2) 0;
}

.search__input {
  flex: 1;
  height: 96rpx;
  background: var(--c-white);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-btn);
  padding: 0 var(--s-3);
  font-size: var(--f-body);
  color: var(--c-ink);
  box-sizing: border-box;
}

.search__btn {
  width: 150rpx;
  margin-left: var(--s-2);
  padding: 0;
}

.row {
  background: var(--c-white);
  border-radius: var(--r-btn);
  padding: var(--s-2) var(--s-3);
  margin-bottom: var(--s-1);
  font-size: var(--f-small);
  color: var(--c-ink);
  line-height: 1.6;
  word-break: break-all;
}

.empty,
.loading {
  padding: var(--s-4) 0;
  text-align: center;
  font-size: var(--f-small);
  color: var(--c-ink-3);
}

.error {
  margin-top: var(--s-2);
  padding: var(--s-2) var(--s-3);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
}

.hint {
  margin-top: var(--s-3);
  font-size: 22rpx;
  color: var(--c-ink-3);
  text-align: center;
}
