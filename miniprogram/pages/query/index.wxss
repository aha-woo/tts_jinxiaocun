/* 查一查 */
.hint {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
}

.search {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.search__in {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--sf);
  border: 2rpx solid var(--ln);
  border-radius: var(--r-pill);
  font-size: 28rpx;
}

.search__ph {
  color: var(--mu);
}

.search__btn {
  width: auto !important;
  min-width: 0;
  flex-shrink: 0;
  margin: 0 !important;
  height: 88rpx;
  padding: 0 40rpx;
  border-radius: var(--r-pill);
  background: var(--ink);
  color: var(--sf);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.row {
  padding: 20rpx 24rpx;
  border-top: 2rpx solid var(--ln);
  font-size: 26rpx;
  color: var(--ink);
  word-break: break-all;
}

.row:first-child {
  border-top: 0;
}

/* 单据行：左侧摘要 + 右侧「改」 */
.doc {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-top: 2rpx solid var(--ln);
}

.doc:first-child {
  border-top: 0;
}

.doc__l {
  flex: 1;
  min-width: 0;
}

.doc__t {
  display: block;
  font-weight: 700;
  font-size: 30rpx;
}

.doc__s {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.doc__go {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--act);
}
