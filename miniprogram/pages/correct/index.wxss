/* 改单卡 */
.pad {
  padding: 24rpx;
}

.head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  font-weight: 700;
  background: var(--acs);
  color: var(--act);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.no {
  font-size: 24rpx;
  color: var(--mu);
  font-variant-numeric: tabular-nums;
}

.date {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--mu);
}

.total {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.c-title {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.line {
  padding: 16rpx 0;
  border-top: 2rpx solid var(--ln);
}

.line:first-of-type {
  border-top: 0;
}

.muted {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  margin-bottom: 10rpx;
}

.line__edit {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.in {
  width: 160rpx;
  height: 88rpx;
  background: var(--bg);
  border: 2rpx solid var(--ln);
  border-radius: 16rpx;
  text-align: center;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 34rpx;
  font-weight: 700;
}

.unit {
  font-size: 26rpx;
  color: var(--mu);
}

.hint {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  margin-top: 12rpx;
}

.sub {
  height: 96rpx;
  border-radius: 22rpx;
  border: 2rpx solid var(--ln);
  background: var(--sf);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
