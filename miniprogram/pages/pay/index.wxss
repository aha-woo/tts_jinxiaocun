/* 套餐 */
.pad {
  padding: 24rpx;
}

.pad-b {
  padding: 24rpx 24rpx 0;
}

.c-title {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.num {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.num__v {
  font-size: 52rpx;
  font-weight: 700;
}

.num__v--gap {
  margin-left: 32rpx;
}

.num__u {
  font-size: 24rpx;
  color: var(--mu);
}

.plan {
  display: block;
  font-size: 30rpx;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  line-height: 1.6;
  margin-top: 8rpx;
}

.goods {
  padding: 24rpx;
  border-top: 2rpx solid var(--ln);
  margin-top: 8rpx;
}

.goods__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.goods__title-wrap {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.goods__name {
  font-weight: 700;
  font-size: 30rpx;
  color: var(--ink);
}

.goods__price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ac);
  white-space: nowrap;
}

.goods__desc {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  line-height: 1.55;
  margin: 10rpx 0 18rpx;
}

.goods__buy {
  min-height: 84rpx !important;
  font-size: 28rpx !important;
}
