/* 套餐（方案 A）：三张白卡，数字大、文案短；不用渐变卡片 */
.page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: var(--s-3);
  box-sizing: border-box;
}

.card {
  background: var(--c-white);
  border-radius: var(--r-card);
  padding: var(--s-3) var(--s-4);
  margin-bottom: var(--s-2);
  border: 1rpx solid var(--c-line);
}

.card__title {
  font-size: var(--f-small);
  color: var(--c-ink-3);
  margin-bottom: var(--s-1);
}

.stats {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.stats__num {
  font-size: var(--f-amount);
  font-weight: 800;
  color: var(--c-ink);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.stats__num--days {
  margin-left: var(--s-3);
  color: var(--c-brand-dark);
}

.stats__unit {
  margin-left: var(--s-1);
  font-size: var(--f-small);
  color: var(--c-ink-2);
}

.entitle__name {
  font-size: var(--f-title);
  font-weight: 700;
  color: var(--c-brand-dark);
  margin-bottom: var(--s-1);
}

.goods {
  border-top: 1rpx solid var(--c-line);
  padding: var(--s-2) 0;
}

.goods:first-of-type {
  border-top: none;
}

.goods__main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.goods__name {
  font-size: var(--f-body);
  font-weight: 600;
  color: var(--c-ink);
}

.goods__price {
  font-size: var(--f-title);
  font-weight: 800;
  color: var(--c-accent);
  font-variant-numeric: tabular-nums;
}

.goods__desc {
  margin-top: 4rpx;
  font-size: var(--f-small);
  color: var(--c-ink-3);
  line-height: 1.5;
}

.goods__buy {
  margin-top: var(--s-2);
}

.warn {
  margin-top: var(--s-2);
  padding: var(--s-2) var(--s-3);
  background: var(--c-warn-bg);
  color: var(--c-warn-ink);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
  line-height: 1.5;
}

.message {
  margin-top: var(--s-2);
  padding: var(--s-2) var(--s-3);
  background: var(--c-brand-soft);
  color: var(--c-brand-dark);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
}

.error {
  margin-top: var(--s-2);
  padding: var(--s-2) var(--s-3);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
}

.hint {
  margin-top: var(--s-1);
  font-size: 22rpx;
  color: var(--c-ink-3);
  line-height: 1.5;
}
