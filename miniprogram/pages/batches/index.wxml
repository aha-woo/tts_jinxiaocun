<!-- 批次余量与虚拟未到货 -->
<view class="page">
  <view class="page__gap">
    <text class="hint">同一件货可能有好几批：卖货默认按「先到期先出 / 先进先出」自动扣；负库存挂「未到货」，补进货自动抵扣。</text>

    <view wx:if="{{loading}}" class="empty">读取中…</view>
    <view wx:elif="{{items.length === 0}}" class="empty">还没有在库批次</view>

    <view wx:else class="card">
      <view wx:for="{{items}}" wx:key="batch_id" class="bt">
        <view class="bt__l">
          <text class="bt__t">{{item.titleText}}</text>
          <text class="bt__s">
            进 {{item.qty_in}}{{item.base_unit || ''}} · 剩 {{item.qty_left}}{{item.base_unit || ''}} · 成本 {{item.unitCostText}}
          </text>
          <text class="bt__e" wx:if="{{item.expiry_date}}">到期 {{item.expiry_date}}</text>
        </view>
        <text class="bt__tag {{item.is_virtual ? 'bt__tag--virtual' : item.status === 'open' ? 'bt__tag--open' : ''}}">
          {{item.statusText}}
        </text>
      </view>
    </view>

    <view wx:if="{{errorText}}" class="bar" style="background:var(--dgrb);border-color:#e0b9b0;color:var(--dgr)">
      <text>{{errorText}}</text>
    </view>
  </view>
</view>
