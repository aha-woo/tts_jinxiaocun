/* 盘点（接后端） */
.cstat {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
}

.cstat__b {
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 36rpx;
  font-weight: 700;
}

.cstat__mu {
  color: var(--mu);
  font-size: 24rpx;
}

.ci {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-top: 2rpx solid var(--ln);
}

.ci:first-child {
  border-top: 0;
}

.ci--done {
  background: var(--acs);
}

.ci__md {
  flex: 1;
  min-width: 0;
}

.ci__n {
  display: block;
  font-weight: 700;
  font-size: 30rpx;
}

.ci__s {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
  margin-top: 4rpx;
}

.ci__rt {
  text-align: right;
  min-width: 120rpx;
}

.ci__q {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 30rpx;
  font-weight: 700;
}

.ci__d {
  display: block;
  font-size: 22rpx;
  color: var(--act);
  margin-top: 2rpx;
}

.c-actions {
  display: flex;
  gap: 14rpx;
}

.c-act-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 20rpx;
  background: var(--sf);
  border: 2rpx solid var(--ln);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.c-reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.c-reason {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--bg);
  border: 2rpx solid var(--ln);
  font-size: 24rpx;
  color: var(--mu);
}

.c-reason--on {
  background: var(--acs);
  border-color: var(--ac);
  color: var(--ink);
  font-weight: 600;
}

.count-top {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.count-top__apply {
  display: none !important;
}

/* 电脑版微信大屏（>=768px）：顶部工具栏 + 双列盘点网格 + 居中键盘弹窗 */
@media (min-width: 768px) {
  .count-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .cstat {
    gap: 12px;
    font-size: 14px;
  }

  .cstat__b {
    font-size: 20px;
  }

  .cstat__mu {
    font-size: 13px;
  }

  .c-actions {
    gap: 10px;
    align-items: center;
  }

  .c-act-btn {
    flex: 0 0 auto;
    height: 40px;
    padding: 0 16px;
    border-radius: 10px;
    border-width: 1px;
    font-size: 13px;
    cursor: pointer;
  }

  .count-top__apply {
    display: flex !important;
    width: auto !important;
    min-height: 40px !important;
    padding: 0 18px !important;
    font-size: 13px !important;
  }

  .count-bottom-apply {
    display: none !important;
  }

  .count-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    background: transparent !important;
    border: none !important;
    overflow: visible !important;
  }

  .ci {
    background: var(--sf);
    border: 1px solid var(--ln) !important;
    border-radius: 12px;
    padding: 14px 18px;
    cursor: pointer;
  }

  .ci:hover {
    border-color: var(--ac) !important;
  }

  .ci__n {
    font-size: 15px;
  }

  .ci__s {
    font-size: 12px;
  }

  .ci__q {
    font-size: 16px;
  }

  .ci__d {
    font-size: 12px;
  }

  .c-reason {
    font-size: 12px;
    padding: 5px 12px;
    cursor: pointer;
  }
}
