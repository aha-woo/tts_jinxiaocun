/* 确认卡（纸感） */
.act {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.act__top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.act__amt {
  font-size: 48rpx;
  font-weight: 700;
}

.pad {
  padding: 24rpx;
}

.c-title {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.c-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.said {
  background: var(--bg);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 30rpx;
  line-height: 1.55;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  margin-top: 12rpx;
}

.opts {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.opt {
  flex: 1 1 auto;
  min-height: 84rpx;
  border-radius: 18rpx;
  border: 3rpx solid var(--ln);
  background: var(--sf);
  font-weight: 700;
  font-size: 28rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rows {
  border: 2rpx solid var(--ln);
  border-radius: 20rpx;
  padding: 0 22rpx;
  margin-top: 8rpx;
}

.r {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--ln);
}

.r:first-child {
  border-top: 0;
}

.r__k {
  color: var(--mu);
  font-size: 26rpx;
  padding-top: 2rpx;
  white-space: nowrap;
}

.r__v {
  text-align: right;
  font-weight: 700;
  font-size: 28rpx;
}

.r__edit {
  font-size: 22rpx;
  color: var(--act);
  font-weight: 500;
  margin-left: 8rpx;
}

.total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 18rpx;
  margin-top: 6rpx;
  border-top: 2rpx solid var(--ln);
  font-size: 26rpx;
  color: var(--mu);
}

.total__n {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.link {
  font-size: 24rpx;
  color: var(--act);
  font-weight: 700;
}

.trace {
  font-size: 24rpx;
  color: var(--mu);
  font-variant-numeric: tabular-nums;
  margin-top: 8rpx;
}

.hidden {
  display: none;
}

.subs {
  display: flex;
  gap: 16rpx;
}

.sub {
  flex: 1;
  height: 96rpx;
  border-radius: 22rpx;
  border: 2rpx solid var(--ln);
  background: var(--sf);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sub--main {
  background: var(--ac);
  border-color: var(--ac);
  color: #fff;
  font-weight: 700;
}

/* 空格：红=必须现在填，黄=可以后补 */
.gap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  margin-top: 12rpx;
}

.gap--must {
  background: #fcede5;
  border: 2rpx solid #e9bda5;
}

.gap--later {
  background: var(--wnb);
  border: 2rpx solid var(--wnl);
}

.gap__l {
  min-width: 0;
}

.gap__k {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
}

.gap__v {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.gap--must .gap__v {
  color: var(--act);
}

.gap--later .gap__v {
  color: var(--wn);
}

.gap__go {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--act);
}

/* 补数字键盘 */
.kpsheet {
  position: fixed;
  inset: 0;
  background: rgba(31, 27, 22, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 70;
}

.kpsheet__in {
  width: 100%;
  background: var(--sf);
  border-radius: 36rpx 36rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.kpsheet__h {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  color: var(--mu);
}

.kpsheet__v {
  display: block;
  text-align: center;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 72rpx;
  font-weight: 700;
  padding: 8rpx 0 20rpx;
  border-bottom: 2rpx solid var(--ink);
}

.kpsheet__u {
  font-size: 30rpx;
  color: var(--mu);
  margin-left: 8rpx;
}

.kp {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.kp__k {
  height: 100rpx;
  border-radius: 18rpx;
  background: var(--bg);
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kp__k:active {
  background: var(--acs);
}

.kp__acts {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.kp__c,
.kp__ok {
  flex: 1;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kp__c {
  border: 2rpx solid var(--ln);
  background: var(--sf);
}

.card-layout,
.card-main,
.card-r-rest {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-width: 0;
}

.kp__ok {
  background: var(--ac);
  color: #fff;
  font-weight: 700;
}

/* 电脑版微信大屏（>=768px）：左明细 + 右操作与影响预览双栏；键盘居中弹窗 */
@media (min-width: 768px) {
  .card-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) 360px;
    gap: 16px 20px;
    align-items: start;
  }

  .card-main {
    grid-column: 1;
    grid-row: 1 / span 4;
    gap: 16px;
  }

  .card-r-top {
    grid-column: 2;
    grid-row: 1;
  }

  .card-r-rest {
    grid-column: 2;
    grid-row: 2;
    gap: 14px;
    align-self: start;
  }

  .act,
  .pad {
    padding: 18px 20px;
  }

  .act {
    gap: 14px;
  }

  .act__amt {
    font-size: 28px;
  }

  .c-title {
    font-size: 16px;
    margin-bottom: 10px;
  }

  .said {
    font-size: 15px;
    padding: 12px 14px;
    border-radius: 10px;
  }

  .hint,
  .link,
  .trace {
    font-size: 12px;
  }

  .rows {
    border-width: 1px;
    border-radius: 12px;
    padding: 0 14px;
  }

  .r {
    padding: 11px 0;
    border-top-width: 1px;
  }

  .r__k,
  .r__v {
    font-size: 14px;
  }

  .total {
    padding-top: 12px;
    font-size: 14px;
  }

  .total__n {
    font-size: 22px;
  }

  .sub {
    height: 44px;
    border-radius: 12px;
    border-width: 1px;
    font-size: 14px;
    cursor: pointer;
  }

  .kpsheet {
    align-items: center;
    justify-content: center;
  }

  .kpsheet__in {
    max-width: 420px;
    border-radius: 18px;
    padding: 24px;
  }

  .kpsheet__h {
    font-size: 15px;
  }

  .kpsheet__v {
    font-size: 36px;
    padding: 6px 0 12px;
  }

  .kp {
    gap: 8px;
    margin-top: 14px;
  }

  .kp__k {
    height: 48px;
    border-radius: 10px;
    font-size: 20px;
    cursor: pointer;
  }

  .kp__c,
  .kp__ok {
    height: 44px;
    border-radius: 10px;
    font-size: 15px;
    cursor: pointer;
  }
}
