<!--
  确认卡片（面向商户，不是调试面板）

  设计原则
  --------
  - 首屏四样：方向 / 金额 / 影响 / 主按钮（`data-role` 是机器可读锚点）。
  - **内部字段不上屏**：槽位代号（P/Q/U/UP/TA/S/D/PS/W）、风险等级 R1、确认方式 C1、
    「来源」角标、数据版本，全部收进底部「解析明细（开发用）」，默认折叠。
  - 只写人话：已结→已付清、未结→还欠着；商品未建档时明确提示「先建商品」。
  - 7 个 `data-block` 一个不少（服务端契约与测试都依赖它），但视觉上只保留用户需要的。
-->
<view class="page {{wide ? 'page--wide' : ''}}">
  <!-- ⑦ 操作区（吸顶）：第一行方向+金额+倒计时，第二行整宽主按钮（拇指好按） -->
  <view class="actionbar" wx:if="{{card}}" data-block="actions">
    <view class="actionbar__row">
      <view class="actionbar__dir actionbar__dir--{{card.intent.domain}}" data-role="direction">
        <text>{{directionText}}</text>
      </view>
      <view class="actionbar__main">
        <view class="actionbar__amount" data-role="amount">{{totalAmountText}}</view>
        <view class="actionbar__timer {{expired ? 'actionbar__timer--expired' : ''}}">
          {{expired ? '已超时' : '还剩 ' + countdown + ' 秒'}}
        </view>
      </view>
    </view>
    <button class="btn btn--primary btn--block" bindtap="onConfirm" loading="{{loading}}">
      {{card.actions.primary_label}}
    </button>
  </view>

  <!-- 澄清（方向/槽位没判清时先问，不猜） -->
  <view class="card" wx:if="{{clarify}}">
    <view class="card__title">要确认一下</view>
    <view class="quote">{{clarify.question}}</view>
    <view class="clarify__options">
      <view
        wx:for="{{clarify.options}}"
        wx:key="*this"
        class="clarify__option"
        data-value="{{item}}"
        bindtap="onClarify"
      >{{item}}</view>
    </view>
  </view>

  <!-- ① 原文 -->
  <view class="card" wx:if="{{card}}" data-block="original">
    <view class="card__title">你刚说的</view>
    <view class="quote">{{card.original.asr_text}}</view>
    <view class="hint" wx:if="{{card.original.low_confidence_highlight}}">
      这句听得不太准，请重点核对下面的数字
    </view>
  </view>

  <!-- ② 意图 + ④ 计算：人话标题 + 明细 + 合计 -->
  <view class="card" wx:if="{{card}}" data-block="intent">
    <view class="card__title">{{cardTitle}}</view>
    <view class="lines">
      <view class="line" wx:for="{{card.calc.lines}}" wx:key="product_label">
        <text class="line__name">{{item.product_label}}</text>
        <text class="line__qty">{{item.quantity}}{{item.unit}}</text>
        <text class="line__amount">{{item.amount_display}}</text>
      </view>
    </view>
    <view class="total">
      <text>合计</text>
      <text class="total__num">{{totalAmountText}}</text>
    </view>
  </view>

  <!-- ③ 基本信息（只展示用户关心的四项，空值自动隐藏） -->
  <view class="card" wx:if="{{card && infoFields.length > 0}}">
    <view class="card__title">这笔的基本信息</view>
    <view class="kv" wx:for="{{infoFields}}" wx:key="label">
      <text>{{item.label}}</text>
      <text>{{item.value}}</text>
    </view>
  </view>

  <!-- 商品未建档：明确告诉用户下一步怎么做，而不是让他点确认然后失败 -->
  <view class="card card--warn" wx:if="{{card && hasPendingProduct}}">
    <view class="card__title">这个商品还没有档案</view>
    <view class="hint">先去首页说一句「新建商品 可乐」，建好之后再回来记这笔；现在点确认会失败。</view>
  </view>

  <!-- ⑤ 影响预览（组件内已改成「记上之后会变成」的人话） -->
  <impact-preview
    wx:if="{{card}}"
    data-block="impact"
    rows="{{card.impact}}"
    previewVersion="{{card.meta.preview_version}}"
    note=""
  />

  <!-- ⑥ 风险 -->
  <view class="card card--warn" wx:if="{{card && card.risk.level !== 'ok'}}" data-block="risk">
    <view class="card__title">要注意</view>
    <view class="hint">{{card.risk.reason_zh}}</view>
    <view class="hint" wx:for="{{card.risk.conflicts}}" wx:key="*this">· {{item}}</view>
  </view>

  <!-- C2 二次语音 + 按钮兜底 -->
  <view class="card" wx:if="{{needSecondVoice}}">
    <view class="card__title">这笔要再确认一次</view>
    <view class="hint">点下面说一句「确认」，或者直接按上方主按钮（会记为按钮兜底）</view>
    <button class="btn btn--ghost" bindtap="onSecondVoice">我说了「确认」</button>
  </view>

  <!-- 解析明细：开发排查用，默认折叠；7 区块里的 slots/calc 落在这里 -->
  <view class="card" wx:if="{{card}}">
    <view class="card__head" bindtap="onToggleDevDetail">
      <text class="card__title">解析明细（开发用）</text>
      <text class="link">{{devDetail ? '收起' : '展开'}}</text>
    </view>
    <block wx:if="{{devDetail}}">
      <slot-table rows="{{card.slots}}" data-block="slots" />
      <view class="trace" wx:for="{{card.calc.calc_traces}}" wx:key="*this">= {{item}}</view>
      <view class="hint">
        风险 {{card.intent.risk_level}} · 确认方式 {{card.intent.confirm_policy}} ·
        数据版本 v{{card.meta.preview_version}}
      </view>
    </block>
    <view class="hidden" data-block="calc"></view>
  </view>

  <view class="error" wx:if="{{errorText}}">{{errorText}}</view>

  <view class="footer" wx:if="{{card}}">
    <button class="btn btn--secondary" bindtap="onCancel">先不记</button>
    <button class="btn btn--primary" bindtap="onConfirm" loading="{{loading}}">
      {{card.actions.primary_label}}
    </button>
  </view>
</view>
