<!--
  确认卡（原型 oCard 的纸感版本）
  - 保留 7 个 data-block 锚点：actions / original / intent / impact / risk / slots / calc
  - 手机端单列纵向（actions 首屏最前）；电脑版微信大屏（>=768px）左明细 + 右操作/影响预览双栏
-->
<view data-ui="v2" class="page {{wide ? 'page--wide' : ''}}">
  <view class="page__gap card-layout">
    <!-- ⑦ 操作区（DOM 最前，桌面端放右上角） -->
    <view class="card act card-r-top" wx:if="{{card}}" data-block="actions">
      <view class="act__top">
        <view style="display:flex;align-items:center;gap:12rpx">
          <text class="tg tg--owe" data-role="direction">{{directionText}}</text>
          <text wx:if="{{noviceText}}" class="tg tg--in">{{noviceText}}</text>
        </view>
        <text class="act__amt serif-num" data-role="amount">{{totalAmountText}}</text>
      </view>
      <button class="cta" bindtap="onConfirm" loading="{{loading}}" disabled="{{hasMustGap}}">{{card.actions.primary_label}}</button>
      <text wx:if="{{hasMustGap}}" class="hint" style="text-align:center">红色的项填上才能确认</text>
    </view>

    <!-- 左主栏：澄清 + 原文 + 明细 + 基本信息 + 空格 + 解析 -->
    <view class="card-main">
      <!-- 澄清 -->
      <view class="card pad" wx:if="{{clarify}}">
        <text class="c-title">要确认一下</text>
        <view class="said">{{clarify.question}}</view>
        <view class="opts">
          <view
            wx:for="{{clarify.options}}"
            wx:key="*this"
            class="opt"
            data-value="{{item}}"
            bindtap="onClarify"
          >{{item}}</view>
        </view>
      </view>

      <!-- ① 原文 -->
      <view class="card pad" wx:if="{{card}}" data-block="original">
        <text class="c-title">你说的</text>
        <view class="said">“{{card.original.asr_text}}”</view>
        <text class="hint" wx:if="{{card.original.low_confidence_highlight}}">这句听得不太准，请重点核对下面的数字</text>
      </view>

      <!-- ② 意图 + 明细 -->
      <view class="card pad" wx:if="{{card}}" data-block="intent">
        <view class="c-head">
          <text class="c-title">{{cardTitle}}</text>
          <view style="display:flex;gap:18rpx;align-items:center">
            <text
              class="link"
              data-code="Q"
              bindtouchstart="onFieldVoiceStart"
              bindtouchend="onFieldVoiceEnd"
            >{{voiceListening && voiceFieldSlot === 'Q' ? '松手完成' : '按住重说数量'}}</text>
            <text class="link" bindtap="onLineTap">改 ›</text>
          </view>
        </view>
        <view class="rows">
          <view class="r" wx:for="{{card.calc.lines}}" wx:key="product_label" bindtap="onLineTap">
            <text class="r__k">{{item.product_label}}</text>
            <text class="r__v">{{item.quantity}}{{item.unit}} · {{item.amount_display}} <text class="r__edit">改</text></text>
          </view>
        </view>
        <view class="total">
          <text>合计</text>
          <text class="total__n serif-num">{{totalAmountText}}</text>
        </view>
      </view>

      <!-- ③ 基本信息 -->
      <view class="card pad" wx:if="{{card && infoFields.length > 0}}">
        <text class="c-title">这笔的基本信息</text>
        <view class="rows">
          <view
            class="r"
            wx:for="{{infoFields}}"
            wx:key="code"
            data-code="{{item.code}}"
            data-label="{{item.label}}"
            data-value="{{item.value}}"
            bindtap="onInfoTap"
          >
            <text class="r__k">{{item.label}}</text>
            <text class="r__v">{{item.value}} <text class="r__edit">改</text></text>
          </view>
        </view>
      </view>

      <!-- 空格：红=必须现在填，黄=可以后补 -->
      <view class="card pad" wx:if="{{gaps.length > 0}}">
        <text class="c-title">还差这几项</text>
        <view
          wx:for="{{gaps}}"
          wx:key="code"
          class="gap {{item.must ? 'gap--must' : 'gap--later'}}"
          data-code="{{item.code}}"
          bindtap="onGapTap"
        >
          <view class="gap__l">
            <text class="gap__k">{{item.label}}</text>
            <text class="gap__v">{{item.current || '没填'}} {{item.unit}}</text>
          </view>
          <text class="gap__go">补 ›</text>
        </view>
        <text class="hint">红的是现在就得填；黄的可以先记上，利润先不算它。</text>
      </view>

      <!-- 近似商品防重提示 -->
      <view class="card pad" wx:if="{{card && hasPendingProduct && similarProducts.length > 0 && !similarDismissed}}" style="border:2rpx solid var(--wnl);background:var(--wnb)">
        <text class="c-title">店里有「{{similarProducts[0].name}}」，是它吗？</text>
        <text class="hint" style="margin-top:0">免得同一样货建出两个档案</text>
        <view class="opts">
          <view class="opt" data-name="{{similarProducts[0].name}}" bindtap="onAcceptSimilar">就是它</view>
          <view class="opt" bindtap="onDismissSimilar">是新货</view>
        </view>
      </view>

      <!-- 解析明细（开发用） -->
      <view class="card pad" wx:if="{{card}}">
        <view class="c-head" bindtap="onToggleDevDetail">
          <text class="c-title">解析明细（开发用）</text>
          <text class="link">{{devDetail ? '收起' : '展开'}}</text>
        </view>
        <block wx:if="{{devDetail}}">
          <slot-table rows="{{card.slots}}" data-block="slots" />
          <view class="trace" wx:for="{{card.calc.calc_traces}}" wx:key="*this">= {{item}}</view>
          <text class="hint">风险 {{card.intent.risk_level}} · 确认方式 {{card.intent.confirm_policy}} · 数据版本 v{{card.meta.preview_version}}</text>
        </block>
        <view class="hidden" data-block="calc"></view>
      </view>

      <view wx:if="{{errorText}}" class="bar" style="background:var(--dgrb);border-color:#e0b9b0;color:var(--dgr)">
        <text>{{errorText}}</text>
      </view>
    </view>

    <!-- 右副栏：未建档提醒 + ⑤ 影响预览 + ⑥ 风险 + 底部次操作 -->
    <view class="card-r-rest">
      <!-- 商品未建档：进货自动建档；卖货没有库存，不能卖 -->
      <view class="bar" wx:if="{{card && hasPendingProduct}}" style="background:{{directionText === '卖货' ? 'var(--dgrb)' : 'var(--wnb)'}};border-color:{{directionText === '卖货' ? '#e0b9b0' : 'var(--wnl)'}};color:{{directionText === '卖货' ? 'var(--dgr)' : 'var(--wn)'}}">
        <text>{{directionText === '卖货' ? '档案里没有这件货，库存也没有，卖不了；要卖请先记一笔进货。' : '这件货还没有档案，确认后会自动建档；缺的进价会进「要补」。'}}</text>
      </view>

      <!-- ⑤ 影响预览 -->
      <impact-preview
        wx:if="{{card}}"
        data-block="impact"
        rows="{{card.impact}}"
        previewVersion="{{card.meta.preview_version}}"
        note=""
      />

      <!-- ⑥ 风险 -->
      <view class="bar" wx:if="{{card && card.risk.level !== 'ok'}}" data-block="risk">
        <text>要注意：{{card.risk.reason_zh}}{{card.risk.conflicts.length ? '（' + card.risk.conflicts[0] + '）' : ''}}</text>
      </view>

      <!-- 底部次操作 -->
      <view class="subs" wx:if="{{card}}">
        <button class="sub" bindtap="onCancel">先不记</button>
        <button class="sub sub--main" bindtap="onConfirm" loading="{{loading}}" disabled="{{hasMustGap}}">{{card.actions.primary_label}}</button>
      </view>
    </view>
  </view>

  <!-- 补数字键盘 -->
  <view class="kpsheet" wx:if="{{editingGap}}">
    <view class="kpsheet__in">
      <text class="kpsheet__h">补 {{editingGap.label}}</text>
      <text class="kpsheet__v">{{gapKeypad || '0'}}<text class="kpsheet__u">{{editingGap.unit}}</text></text>
      <view class="kp">
        <view wx:for="{{['1','2','3','4','5','6','7','8','9','.','0','del']}}" wx:key="*this" class="kp__k" data-key="{{item}}" bindtap="onGapKey">{{item === 'del' ? '删' : item}}</view>
      </view>
      <view class="kp__acts">
        <button class="kp__c" bindtap="onGapClose">取消</button>
        <button class="kp__ok" bindtap="onGapKeyOk">补上</button>
      </view>
    </view>
  </view>
</view>
