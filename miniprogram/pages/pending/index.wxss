.page {
  min-height: 100vh;
  background: #f4f6f8;
  padding: 20rpx;
  box-sizing: border-box;
}

.hint {
  background: #fff8e6;
  color: #8a5300;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.item__main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.item__title {
  font-size: 28rpx;
  color: #1f2328;
  font-weight: 600;
}

.item__amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2328;
}

.item__meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e8f0ff;
  color: #1554b5;
}

.badge--expired {
  background: #fde8e8;
  color: #b42318;
}

.item__version {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #9aa4ae;
}

.item__actions {
  display: flex;
  margin-top: 16rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.btn:last-child {
  margin-right: 0;
}

.btn--primary {
  background: #1f6feb;
  color: #fff;
}

.btn--ghost {
  background: #f1f3f5;
  color: #4b5563;
}

.empty,
.loading {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9aa4ae;
}

.error {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fde8e8;
  color: #b42318;
  border-radius: 12rpx;
  font-size: 24rpx;
}
