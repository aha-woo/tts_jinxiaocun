/* 待处理：两层整齐排版 + 定宽短按钮 + 不折行状态标签 */
.hint {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  line-height: 1.6;
  padding: 0 8rpx;
}

.pend {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-top: 2rpx solid var(--ln);
}

.pend:first-child {
  border-top: 0;
}

.pend:active {
  background: var(--acs);
}

.pend__md {
  flex: 1;
  min-width: 0;
}

.pend__meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pend__tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.pend__tag--warn {
  background: var(--wnb);
  color: var(--wn);
}

.pend__tag--danger {
  background: var(--dgrb);
  color: var(--dgr);
}

.pend__kind {
  font-size: 22rpx;
  color: var(--mu);
  font-weight: 600;
  white-space: nowrap;
}

.pend__t {
  display: block;
  margin-top: 8rpx;
  font-weight: 700;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--ink);
  word-break: break-all;
}

.pend__go {
  width: 144rpx;
  text-align: center;
  white-space: nowrap;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--act);
  padding: 12rpx 0;
  border-radius: var(--r-pill);
  background: var(--acs);
  border: 2rpx solid #eabaa0;
  box-sizing: border-box;
}
