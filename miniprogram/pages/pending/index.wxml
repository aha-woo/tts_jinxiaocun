<!-- 待处理（原型 vPending）：没确认 / 要补；标签不换行 + 按钮等宽对齐 + 统一数字键盘 -->
<view class="page">
  <view class="page__gap">
    <view class="seg">
      <view class="seg__item {{tab === 'unconf' ? 'seg__item--on' : ''}}" data-tab="unconf" bindtap="onTab">
        没确认 {{unconfCount}}
      </view>
      <view class="seg__item {{tab === 'fill' ? 'seg__item--on' : ''}}" data-tab="fill" bindtap="onTab">
        要补 {{fillCount}}
      </view>
    </view>

    <text class="hint">
      {{tab === 'unconf' ? '说过但没点确认的卡。打开后还是同一张卡，不会重复扣次数。' : '账已经记了，就差这一项。点右侧按钮直接处理，不用打开整张卡。'}}
    </text>

    <view class="card">
      <view wx:if="{{loading}}" class="empty">加载中…</view>
      <view wx:elif="{{shown.length === 0 && (tab === 'unconf' || ledgerGaps.length === 0)}}" class="empty">
        {{tab === 'fill' ? '没有要补的' : '都处理完了'}}
      </view>

      <view
        wx:for="{{shown}}"
        wx:key="cardId"
        class="pend"
        data-card="{{item.cardId}}"
        bindtap="onOpen"
        bindlongpress="onDiscardMenu"
      >
        <view class="pend__md">
          <view class="pend__meta">
            <view class="pend__tag {{item.expired ? 'pend__tag--danger' : 'pend__tag--warn'}}">{{item.statusText}}</view>
            <text class="pend__kind">{{item.title}}</text>
          </view>
          <text class="pend__t" wx:if="{{item.said}}">“{{item.said}}”</text>
        </view>
        <view
          wx:if="{{item.gaps.length > 0}}"
          class="pend__go"
          data-card="{{item.cardId}}"
          data-code="{{item.gaps[0].code}}"
          data-label="{{item.gaps[0].label}}"
          data-unit="{{item.gaps[0].unit}}"
          catchtap="onFillStart"
        >去补齐</view>
        <view wx:else class="pend__go">去打开</view>
      </view>

      <!-- 统一账本待补队列（缺进价 / 负库存 / 缺换算等） -->
      <view
        wx:if="{{tab === 'fill'}}"
        wx:for="{{ledgerGaps}}"
        wx:key="gapId"
        class="pend"
        data-gap="{{item.gapId}}"
        bindtap="onLedgerGapTap"
      >
        <view class="pend__md">
          <view class="pend__meta">
            <view class="pend__tag {{item.kind === 'negative_stock' ? 'pend__tag--danger' : 'pend__tag--warn'}}">{{item.kindLabel}}</view>
          </view>
          <text class="pend__t">{{item.title}}</text>
        </view>
        <view class="pend__go">{{item.actionLabel}}</view>
      </view>
    </view>

    <view wx:if="{{errorText}}" class="bar" style="background:var(--dgrb);border-color:#e0b9b0;color:var(--dgr)">
      <text>{{errorText}}</text>
    </view>
  </view>

  <!-- 统一底部数字键盘 -->
  <keypad-sheet
    visible="{{editing !== null}}"
    title="{{editing ? '补 ' + editing.label : ''}}"
    value="{{keypad}}"
    unit="{{editing ? editing.unit : ''}}"
    confirmText="补上"
    bind:change="onKeyChange"
    bind:confirm="onKeyOk"
    bind:close="onKeyClose"
  />

  <action-sheet
    visible="{{sheet.visible}}"
    title="{{sheet.title}}"
    subtitle="{{sheet.subtitle}}"
    actions="{{sheet.actions}}"
    bind:select="onSheetSelect"
    bind:close="onSheetClose"
  />
</view>
