/* 库存设置 */
.pad {
  padding: 24rpx;
}

.c-title {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  line-height: 1.6;
  margin-top: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.row--link {
  padding: 24rpx;
}

.row__t {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.row__s {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
  margin-top: 6rpx;
  line-height: 1.5;
}

.row__go {
  color: var(--mu);
  font-size: 32rpx;
}
