<!-- 今天（首页）：手机端单列纵向；电脑版微信大屏左看板 + 右流水双栏 -->
<view class="page {{fontSize === 'big' ? 'page--big' : ''}} {{wide ? 'page--wide' : ''}}">
  <view class="page__gap desk-home">
    <!-- 左栏（手机端为上半部） -->
    <view class="desk-home__left">
      <!-- 问候 -->
      <view class="hello">
        <view>
          <view class="hello__t">{{greeting}}</view>
          <text class="hello__sub">{{dateLabel}}</text>
        </view>
        <view class="pbadge" bindtap="onGoPending">
          <view class="ico ico--sm ico--pending-wn"></view>
          <text>待处理</text>
          <text class="pbadge__n">{{pendingCount}}</text>
        </view>
      </view>

      <!-- 快捷记账：拍整张进货单 / 手动点选 -->
      <view class="quick-strip">
        <view class="quick-chip" bindtap="onGoDeliveryNote">
          <view class="ico-badge ico-badge--ac">
            <view class="ico ico--photo"></view>
          </view>
          <view class="quick-chip__body">
            <text class="quick-chip__t">拍进货单</text>
            <text class="quick-chip__sub">整单自动建档</text>
          </view>
        </view>
        <view class="quick-chip" bindtap="onGoManual">
          <view class="ico-badge ico-badge--ok">
            <view class="ico ico--manual"></view>
          </view>
          <view class="quick-chip__body">
            <text class="quick-chip__t">手动点选</text>
            <text class="quick-chip__sub">不方便说话时用</text>
          </view>
        </view>
      </view>

      <!-- 新手期前 20 笔进度 -->
      <view wx:if="{{novice && novice.in_novice}}" class="bar" style="background:var(--sf);border-color:var(--ln)">
        <text>新手期 {{novice.count}}/{{novice.target}} · 每笔先给你看卡片，顺便记住你的说话习惯</text>
      </view>

      <!-- 周期切换 -->
      <view class="seg">
        <view
          wx:for="{{periods}}"
          wx:key="key"
          class="seg__item {{period === item.key ? 'seg__item--on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPeriod"
        >{{item.label}}</view>
      </view>

      <!-- 三个数 -->
      <view class="card stats">
        <view class="stats__i">
          <text class="stats__k">卖了</text>
          <text class="stats__v">¥{{stats.sell}}</text>
        </view>
        <view class="stats__i">
          <text class="stats__k">进货</text>
          <text class="stats__v">{{stats.buyDisplay}}</text>
        </view>
        <view class="stats__i">
          <text class="stats__k">赊出去</text>
          <text class="stats__v stats__v--owe">¥{{stats.owe}}</text>
        </view>
      </view>

      <!-- 降级提醒（只在非 L0 出现） -->
      <view wx:if="{{degrade.level !== 'L0'}}" class="bar" bindtap="onGoPay">
        <view class="bar__lead">
          <view class="ico ico--sm ico--warn-wn"></view>
          <text>{{degrade.title}} · {{degrade.hint}}</text>
        </view>
        <text class="bar__more">去查看</text>
      </view>

      <!-- 待补提醒：越早补，毛利越准 -->
      <view wx:if="{{fillCount > 0}}" class="bar" bindtap="onGoPending">
        <view class="bar__lead">
          <view class="ico ico--sm ico--warn-wn"></view>
          <text>有 {{fillCount}} 笔缺价格，越早补，毛利越准</text>
        </view>
        <text class="bar__more">去补</text>
      </view>

      <!-- 待处理提醒 -->
      <view wx:if="{{pendingCount > 0}}" class="bar" bindtap="onGoPending">
        <view class="bar__lead">
          <view class="ico ico--sm ico--pending-wn"></view>
          <text>还有 {{pendingCount}} 笔没处理，确认或补上再算今天的账</text>
        </view>
        <text class="bar__more">去处理</text>
      </view>

      <!-- 语音插件不可用时的温和提示（仅真实不可用时展示，不再展示开发者自检面板） -->
      <view wx:if="{{!speechReady && speechReason}}" class="bar">
        <view class="bar__lead">
          <view class="ico ico--sm ico--warn-wn"></view>
          <text>语音暂不可用：{{speechReason}}</text>
        </view>
      </view>

      <view wx:if="{{syncErrorText}}" class="bar" bindtap="onRetryDashboard">
        <view class="bar__lead">
          <view class="ico ico--sm ico--warn-wn"></view>
          <text>{{syncErrorText}}</text>
        </view>
        <text class="bar__more">重试</text>
      </view>

      <view wx:if="{{errorText}}" class="bar" style="background:var(--dgrb);border-color:#e0b9b0;color:var(--dgr)">
        <text>{{errorText}}</text>
      </view>
    </view>

    <!-- 右栏：流水卡片（手机端紧跟在下方） -->
    <view class="desk-home__right">
      <view class="card flow">
        <view class="flow__h">
          <text>{{periodLabel}}流水 · {{flow.length}} 笔</text>
          <text>点一笔可以改</text>
        </view>

        <!-- 桌面表头（仅 >=768px 显示） -->
        <view class="flow__cols" wx:if="{{flow.length > 0}}">
          <text class="flow__col-tm">时间</text>
          <text class="flow__col-md">类型与摘要</text>
          <text class="flow__col-rt">金额</text>
        </view>

        <view wx:if="{{flow.length === 0}}" class="empty">还没有记录。点下面的圆钮说一句。</view>

        <view
          wx:for="{{flow}}"
          wx:key="id"
          class="fi {{item.reversed ? 'fi--rev' : ''}}"
          data-id="{{item.id}}"
          bindtap="onOpenFlow"
        >
          <text class="fi__tm">{{item.time}}</text>
          <view class="fi__md">
            <view>
              <text class="tg {{item.tagClass}}">{{item.tag}}</text>
              <text class="{{item.reversed ? 'fi__strike' : ''}}" style="font-weight:500">{{item.title}}</text>
            </view>
            <text class="fi__md small" wx:if="{{item.meta}}">{{item.meta}}</text>
          </view>
          <view class="fi__rt">
            <text class="{{item.reversed ? 'fi__strike' : ''}}" wx:if="{{item.amountDisplay}}">{{item.amountDisplay}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 直记 5 秒撤回提示条 -->
  <view class="undo-toast" wx:if="{{undoBanner}}">
    <text class="undo-toast__txt">已记：{{undoBanner.summary}}</text>
    <text class="undo-toast__btn" bindtap="onUndoAutoPosted">撤</text>
  </view>

  <!-- 说话面板（避让底部 Tab 与说话按钮，避免被遮挡） -->
  <view class="vsheet-mask" wx:if="{{recording || thinking}}">
    <view class="vsheet">
      <view class="vsheet__in">
        <text class="vsheet__h">{{recording ? '在听…' : '在理解…'}}</text>
        <text class="vsheet__t">{{talkingText || (recording ? '说完停一下，或者点下面「说完了」' : '正在把这句话变成一笔账')}}</text>
        <view class="vsheet__btns">
          <button wx:if="{{recording}}" class="vsheet__stop" bindtap="onStop">说完了</button>
          <button wx:else class="vsheet__stop vsheet__stop--cancel" bindtap="onCancelThinking">取消</button>
        </view>
      </view>
    </view>
  </view>

  <action-sheet
    visible="{{sheet.visible}}"
    title="{{sheet.title}}"
    subtitle="{{sheet.subtitle}}"
    actions="{{sheet.actions}}"
    bind:select="onSheetSelect"
    bind:close="onSheetClose"
  />
</view>
