<!--
  首页 · 手机端主录入（电脑版微信大屏自动变双栏）
  - 大按钮：拇指热区 ≥88×88px，按住说 / 点一下说
  - 状态条：降级态 L0~L4 在 UI 上真的可以看出差别
  - 只有单商户：没有门店切换、没有组织概念
-->
<view data-ui="v1" class="page {{wide ? 'page--wide' : ''}}">
  <!-- 降级态状态条 -->
  <view class="banner banner--{{degrade.tone}}">
    <view class="banner__title">
      <text>{{degrade.title}}</text>
      <text class="banner__level">{{degrade.level}}</text>
      <text class="banner__flag" wx:if="{{degrade.thrifty}}">省额度</text>
    </view>
    <view class="banner__hint">{{degrade.hint}}</view>
  </view>

  <view class="main">
    <view class="panel">
      <!-- 键盘兜底入口：全程可脱离语音记账 -->
      <view class="shortcuts">
        <view class="shortcut" bindtap="onGoManual">
          <text class="shortcut__title">手动记账</text>
          <text class="shortcut__desc">不用说话，点着记</text>
        </view>
        <view class="shortcut" bindtap="onGoPending">
          <text class="shortcut__title">待确认</text>
          <text class="shortcut__desc">超时没确认的单子</text>
        </view>
      </view>
      <view class="shortcuts">
        <view class="shortcut" bindtap="onGoQuery">
          <text class="shortcut__title">查一查</text>
          <text class="shortcut__desc">库存 / 欠款 / 流水</text>
        </view>
        <view class="shortcut" bindtap="onGoPay">
          <text class="shortcut__title">套餐</text>
          <text class="shortcut__desc">买次数 / 续期</text>
        </view>
      </view>
      <view class="shortcut shortcut--wide" bindtap="onGoAdmin">
        <text class="shortcut__title">管理台</text>
        <text class="shortcut__desc">电脑版微信里是双栏大屏；手机上也能进</text>
      </view>
    </view>

    <!-- 右栏（宽屏） / 下方（窄屏）：最近记录 + 自检 -->
    <view class="side">
      <view class="panel">
        <view class="panel__title">最近</view>
        <view class="recent__empty" wx:if="{{recent.length === 0}}">还没有记录</view>
        <view wx:for="{{recent}}" wx:key="id" class="recent__item">
          <text class="recent__text">{{item.text}}</text>
          <text class="recent__meta">{{item.intent}} · {{item.at}}</text>
        </view>
      </view>

      <view class="panel">
        <view class="panel__head" bindtap="onToggleSelfCheck">
          <text class="panel__title">系统自检</text>
          <text class="panel__more">{{selfCheckOpen ? '收起' : '展开'}}</text>
        </view>
        <view class="selfcheck" wx:if="{{selfCheckOpen}}">
          <view class="kv"><text>后端</text><text>{{statusText}}</text></view>
          <view class="kv"><text>版本</text><text>{{backendVersion}}</text></view>
          <view class="kv"><text>契约</text><text>{{contractText}}</text></view>
          <view class="kv"><text>登录态</text><text>{{loginOk ? '已登录' : '未登录（dev 联调可忽略）'}}</text></view>
          <view class="kv"><text>语音识别</text><text>{{speechReady ? '同声传译插件已就绪' : '未启用（走键盘）'}}</text></view>
          <view class="kv" wx:if="{{speechReason}}"><text>不可用原因</text><text>{{speechReason}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <!--
    语音大按钮：**固定在屏幕下半部**（拇指可达区），不再跟着内容流在顶部。
    设计依据：PRD 3.2「大按钮落在单手拇指可达区域」。手机上固定底部；
    电脑版微信大屏（resizable / .page--wide）恢复成常规布局，不做 fixed。
  -->
  <view class="voice-dock">
    <big-button
      recording="{{recording}}"
      durationMs="{{durationMs}}"
      bars="{{bars}}"
      softLimit="{{softLimit}}"
      disabled="{{!degrade.canVoice}}"
      mode="{{mode}}"
      bind:start="onStart"
      bind:stop="onStop"
      bind:modechange="onModeChange"
    />
    <view class="talking" wx:if="{{talkingText}}">{{talkingText}}</view>
    <view class="error" wx:if="{{errorText}}">{{errorText}}</view>
  </view>
</view>
