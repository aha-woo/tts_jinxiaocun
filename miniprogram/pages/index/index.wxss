/* 今天页：手机端一列纵向；电脑版微信大屏（>=768px）左看板 + 右流水双栏 */
.page__gap {
  padding-bottom: 8rpx;
}

.desk-home {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.desk-home__left,
.desk-home__right {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-width: 0;
}

.flow__cols {
  display: none;
}

.self-check-card {
  padding: 22rpx 24rpx;
}

.self-check-head {
  display: flex;
  justify-content: space-between;
}

.self-check-txt {
  font-size: 24rpx;
  color: var(--mu);
}

.self-check-body {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--mu);
  line-height: 1.8;
}

.fi__strike {
  text-decoration: line-through;
  color: var(--mu);
}

.vsheet-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(31, 27, 22, 0.35);
  display: flex;
  align-items: flex-end;
}

.vsheet {
  width: 100%;
  background: var(--sf);
  border-top: 2rpx solid var(--ln);
  border-radius: 36rpx 36rpx 0 0;
  padding: 40rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -20rpx 48rpx -24rpx rgba(0, 0, 0, 0.3);
}

.vsheet__h {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 38rpx;
  font-weight: 700;
}

.vsheet__t {
  display: block;
  margin-top: 16rpx;
  min-height: 96rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--ink);
}

.vsheet__btns {
  margin-top: 24rpx;
}

.vsheet__stop {
  width: 100%;
  height: 100rpx;
  border-radius: 24rpx;
  background: var(--ac);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vsheet__stop:active {
  background: var(--act);
}

.vsheet__stop--cancel {
  background: var(--bg);
  color: var(--ink);
  border: 2rpx solid var(--ln);
}

.undo-toast {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  z-index: 55;
  background: var(--ink);
  color: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.25);
}

.undo-toast__txt {
  font-size: 26rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.undo-toast__btn {
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  background: var(--act);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.quick-strip {
  display: flex;
  gap: 16rpx;
}

.quick-chip {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 6rpx;
  padding: 18rpx 22rpx;
  background: var(--sf);
  border: 2rpx solid var(--ln);
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.quick-chip__sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--mu);
}

/* 电脑版微信大屏（>=768px）：左看板 + 右高密度流水 */
@media (min-width: 768px) {
  .page__gap {
    padding-bottom: 0;
  }

  .desk-home {
    display: grid;
    grid-template-columns: 380px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .desk-home__left {
    gap: 14px;
    position: sticky;
    top: 16px;
  }

  .desk-home__right {
    gap: 14px;
  }

  .quick-strip {
    gap: 10px;
  }

  .quick-chip {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 12px;
    border-width: 1px;
    font-size: 14px;
    cursor: pointer;
  }

  .quick-chip__sub {
    font-size: 12px;
  }

  .self-check-card {
    padding: 12px 14px;
    cursor: pointer;
  }

  .self-check-txt,
  .self-check-body {
    font-size: 12px;
  }

  .flow__cols {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--mu);
    border-top: 1px solid var(--ln);
    border-bottom: 1px solid var(--ln);
  }

  .flow__col-tm {
    width: 64px;
    flex-shrink: 0;
  }

  .flow__col-md {
    flex: 1;
    min-width: 0;
  }

  .flow__col-rt {
    width: 110px;
    text-align: right;
    flex-shrink: 0;
  }

  .fi {
    align-items: center;
    padding: 12px 6px;
    border-radius: 8px;
  }

  .fi:hover {
    background: #faf6ee;
  }

  .fi__rt {
    min-width: 110px;
  }

  .vsheet-mask {
    align-items: center;
    justify-content: center;
  }

  .vsheet {
    max-width: 520px;
    border-radius: 18px;
    border: 1px solid var(--ln);
    padding: 28px;
  }

  .vsheet__h {
    font-size: 20px;
  }

  .vsheet__t {
    font-size: 16px;
    min-height: 60px;
    margin-top: 12px;
  }

  .vsheet__stop {
    height: 44px;
    border-radius: 12px;
    font-size: 15px;
    cursor: pointer;
  }

  .undo-toast {
    max-width: 520px;
    margin: 0 auto;
    left: 0;
    right: 0;
    bottom: 92px;
    border-radius: 12px;
    padding: 12px 16px;
  }

  .undo-toast__txt,
  .undo-toast__btn {
    font-size: 13px;
  }
}
