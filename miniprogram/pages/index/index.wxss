/* 首页（方案 A）：白卡片 + 微信绿 + 大字号，大按钮固定在底部拇指区 */
.page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: var(--s-2) var(--s-3);
  box-sizing: border-box;
  padding-bottom: calc(400rpx + env(safe-area-inset-bottom));
}

/* 宽屏（电脑版微信 resizable）→ 左录入 / 右动态 双栏 */
.page--wide {
  padding-bottom: var(--s-3);
}

.page--wide .main {
  display: flex;
  align-items: flex-start;
}

.page--wide .panel {
  flex: 0 0 520rpx;
  margin-right: var(--s-3);
}

.page--wide .side {
  flex: 1;
  min-width: 0;
}

/* ------------------------------------------------------------------ 状态条 */
.banner {
  border-radius: var(--r-card);
  padding: var(--s-2) var(--s-3);
  margin-bottom: var(--s-2);
}

.banner--ok {
  background: var(--c-brand-soft);
  color: var(--c-brand-dark);
}

.banner--warn {
  background: var(--c-warn-bg);
  color: var(--c-warn-ink);
}

.banner--danger {
  background: var(--c-danger-soft);
  color: var(--c-danger);
}

.banner__title {
  display: flex;
  align-items: center;
  font-size: var(--f-small);
  font-weight: 700;
}

.banner__level,
.banner__flag {
  margin-left: var(--s-1);
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--r-pill);
}

.banner__level {
  border: 1rpx solid currentColor;
}

.banner__flag {
  background: rgba(255, 255, 255, 0.7);
}

.banner__hint {
  margin-top: 6rpx;
  font-size: var(--f-small);
  opacity: 0.9;
}

/* ------------------------------------------------------------------ 卡片 */
.panel {
  background: var(--c-white);
  border-radius: var(--r-card);
  padding: var(--s-3);
  margin-bottom: var(--s-2);
}

.panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel__title {
  font-size: var(--f-body);
  font-weight: 600;
  color: var(--c-ink);
}

.panel__more {
  font-size: var(--f-small);
  color: var(--c-brand-dark);
}

/* ------------------------------------------------------------------ 快捷入口 */
.shortcuts {
  display: flex;
  margin-top: var(--s-2);
}

.shortcut {
  flex: 1;
  background: #f7f8fa;
  border-radius: var(--r-btn);
  padding: var(--s-2) var(--s-3);
  margin-right: var(--s-2);
  min-height: 112rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.shortcut:last-child {
  margin-right: 0;
}

.shortcut--wide {
  margin-right: 0;
  margin-top: var(--s-2);
}

.shortcut__title {
  display: block;
  font-size: var(--f-body);
  font-weight: 600;
  color: var(--c-ink);
}

.shortcut__desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--f-small);
  color: var(--c-ink-3);
}

/* ------------------------------------------------------------------ 最近 */
.recent__item {
  padding: var(--s-2) 0;
  border-bottom: 1rpx solid var(--c-line);
}

.recent__text {
  font-size: var(--f-body);
  color: var(--c-ink);
}

.recent__meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--c-ink-3);
}

.recent__empty {
  padding: var(--s-3) 0;
  font-size: var(--f-small);
  color: var(--c-ink-3);
}

/* ------------------------------------------------------------------ 自检 */
.kv {
  display: flex;
  justify-content: space-between;
  font-size: var(--f-small);
  color: var(--c-ink-2);
  padding: var(--s-1) 0;
  border-bottom: 1rpx solid var(--c-line);
}

.kv:last-child {
  border-bottom: none;
}

/* ------------------------------------------------------------------ 提示 */
.talking {
  text-align: center;
  font-size: var(--f-small);
  color: var(--c-brand-dark);
  margin-top: var(--s-1);
}

.error {
  margin: var(--s-1) 0 0;
  padding: var(--s-2) var(--s-3);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
}

/* ------------------------------------------------------------------ 语音停靠区 */
.voice-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: var(--s-1) var(--s-3) calc(var(--s-2) + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245, 246, 247, 0) 0%, var(--c-bg) 40%);
  box-sizing: border-box;
}

.page--wide .voice-dock {
  position: static;
  background: none;
  padding: var(--s-1) 0 0;
}
