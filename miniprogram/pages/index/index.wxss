/* 今天页：样式主体在 app.wxss，这里只放页面独有的说话面板 */
.page__gap {
  padding-bottom: 8rpx;
}

.fi__strike {
  text-decoration: line-through;
  color: var(--mu);
}

.vsheet-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(31, 27, 22, 0.35);
  display: flex;
  align-items: flex-end;
}

.vsheet {
  width: 100%;
  background: var(--sf);
  border-top: 2rpx solid var(--ln);
  border-radius: 36rpx 36rpx 0 0;
  padding: 40rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -20rpx 48rpx -24rpx rgba(0, 0, 0, 0.3);
}

.vsheet__h {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 38rpx;
  font-weight: 700;
}

.vsheet__t {
  display: block;
  margin-top: 16rpx;
  min-height: 96rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--ink);
}

.vsheet__btns {
  margin-top: 24rpx;
}

.vsheet__stop {
  width: 100%;
  height: 100rpx;
  border-radius: 24rpx;
  background: var(--ac);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vsheet__stop:active {
  background: var(--act);
}

.vsheet__stop--cancel {
  background: var(--bg);
  color: var(--ink);
  border: 2rpx solid var(--ln);
}

.undo-toast {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  z-index: 55;
  background: var(--ink);
  color: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.25);
}

.undo-toast__txt {
  font-size: 26rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.undo-toast__btn {
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  background: var(--act);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.quick-strip {
  display: flex;
  gap: 16rpx;
}

.quick-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--sf);
  border: 2rpx solid var(--ln);
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.quick-chip__sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--mu);
}
