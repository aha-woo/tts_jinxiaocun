/* 我的页 */
.est {
  padding: 28rpx;
}

.est__k {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
}

.est__v {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.est__note {
  display: block;
  font-size: 22rpx;
  color: var(--wn);
  margin-top: 8rpx;
}

.sec {
  font-size: 24rpx;
  color: var(--mu);
  padding: 0 8rpx;
  margin-top: 8rpx;
}

.mine-card {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mine-hint {
  font-size: 24rpx;
  color: var(--mu);
  line-height: 1.6;
}

.mi {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 24rpx;
  border-top: 2rpx solid var(--ln);
  width: 100%;
  text-align: left;
}

.mi:first-child {
  border-top: 0;
}

.mi:active {
  background: var(--acs);
}

.mi__lead {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
}

.mi__body {
  min-width: 0;
  flex: 1;
}

.mi__t {
  display: block;
  font-size: 30rpx;
}

.mi__s {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
  margin-top: 4rpx;
}

.mine-grid,
.mine-col-left,
.mine-col-right {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-width: 0;
}

.mi__ar {
  color: var(--mu);
  font-size: 32rpx;
}

/* 电脑版微信大屏（>=768px）：左资料与设置 + 右功能菜单双栏 */
@media (min-width: 768px) {
  .mine-grid {
    display: grid;
    grid-template-columns: 380px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .mine-col-left,
  .mine-col-right {
    gap: 14px;
  }

  .est {
    padding: 18px 20px;
  }

  .est__k,
  .est__note,
  .sec,
  .mine-hint {
    font-size: 12px;
  }

  .est__v {
    font-size: 24px;
  }

  .mine-card {
    padding: 16px 18px;
    gap: 10px;
  }

  .mi {
    padding: 14px 20px;
    border-top-width: 1px;
    cursor: pointer;
  }

  .mi__lead {
    gap: 12px;
  }

  .mi:hover {
    background: #faf6ee;
  }

  .mi__t {
    font-size: 15px;
  }

  .mi__s {
    font-size: 12px;
    margin-top: 2px;
  }

  .mi__ar {
    font-size: 18px;
  }
}
