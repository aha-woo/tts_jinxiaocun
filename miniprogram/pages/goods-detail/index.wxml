<!-- 货品详情：概览指标 + 档案参数管理 + 在库批次 + 出入库流水台账 -->
<view class="page {{wide ? 'page--wide' : ''}}">
  <view class="page__gap">
    <view wx:if="{{errorText}}" class="bar" style="background:var(--dgrb);border-color:#e0b9b0;color:var(--dgr)">
      <text>{{errorText}}</text>
    </view>

    <view wx:if="{{loading}}" class="card empty">读取中…</view>

    <block wx:elif="{{name}}">
      <!-- 顶部概览卡 -->
      <view class="card pad gd-hero">
        <view class="gd-hero__top">
          <view class="gd-hero__title-wrap">
            <text class="gd-hero__title serif">{{name}}</text>
            <text class="gd-hero__sub">基本单位：{{baseUnit}}</text>
          </view>
          <view class="gd-hero__badges">
            <text wx:if="{{isDraft}}" class="gd-badge gd-badge--wn">待补价草稿</text>
            <text wx:if="{{negative}}" class="gd-badge gd-badge--dgr">负库存</text>
            <text wx:elif="{{low}}" class="gd-badge gd-badge--ac">低库存</text>
            <text class="gd-badge {{trackBatch ? 'gd-badge--vl' : ''}}">{{trackBatch ? '分批核算' : '移动平均'}}</text>
          </view>
        </view>

        <view class="gd-kpis">
          <view class="gd-kpi">
            <text class="gd-kpi__k">当前库存</text>
            <text class="gd-kpi__v serif-num {{negative ? 'gd-kpi__v--dgr' : low ? 'gd-kpi__v--ac' : ''}}">{{stockDisplay}}</text>
          </view>
          <view class="gd-kpi">
            <text class="gd-kpi__k">参考进价 / 均价</text>
            <text class="gd-kpi__v serif-num">{{avgCostText}}</text>
          </view>
          <view class="gd-kpi">
            <text class="gd-kpi__k">默认售价</text>
            <text class="gd-kpi__v serif-num">{{salePriceText}}</text>
          </view>
          <view class="gd-kpi">
            <text class="gd-kpi__k">库存货值</text>
            <text class="gd-kpi__v serif-num {{stockValueWarn ? 'gd-kpi__v--dgr' : ''}}">{{stockValueText}}</text>
          </view>
        </view>
      </view>

      <!-- 档案管理（口径透明 + 点击弹统一数字键盘） -->
      <view class="card pad gd-sec">
        <view class="gd-sec__h">
          <text class="gd-sec__t serif">档案参数与管理</text>
          <text class="gd-sec__hint">仅改默认参考值，不篡改历史账目</text>
        </view>

        <view class="gd-params">
          <!-- 参考进价：已有值时只读，缺价时才允许补录 -->
          <view
            wx:if="{{!costHidden}}"
            class="gd-param {{missingCost ? 'gd-param--tap' : ''}}"
            bindtap="onEditPurchase"
          >
            <view class="gd-param__l">
              <text class="gd-param__t">参考进价</text>
              <text class="gd-param__sub">{{missingCost ? '补录后计入毛利，不改历史批次' : '由进货单与批次自动核算，不可手改'}}</text>
            </view>
            <view class="gd-param__r">
              <text class="gd-param__v {{missingCost ? 'gd-param__v--wn' : ''}}">{{purchaseDisplayText}}</text>
              <text wx:if="{{missingCost}}" class="gd-param__edit">去补 ›</text>
            </view>
          </view>

          <!-- 默认售价 -->
          <view class="gd-param gd-param--tap" bindtap="onEditSale">
            <view class="gd-param__l">
              <text class="gd-param__t">默认售价</text>
              <text class="gd-param__sub">仅作开单默认价，不影响历史订单</text>
            </view>
            <view class="gd-param__r">
              <text class="gd-param__v">{{saleDisplayText}}</text>
              <text class="gd-param__edit">改 ›</text>
            </view>
          </view>

          <!-- 低库存预警线 -->
          <view class="gd-param gd-param--tap" bindtap="onEditLow">
            <view class="gd-param__l">
              <text class="gd-param__t">低库存预警线</text>
              <text class="gd-param__sub">低于此数量在列表提醒，不影响账务</text>
            </view>
            <view class="gd-param__r">
              <text class="gd-param__v">{{lowStockDisplayText}}</text>
              <text class="gd-param__edit">改 ›</text>
            </view>
          </view>
        </view>

        <view class="gd-actions">
          <view class="gd-act-btn" bindtap="onToggleBatch">
            <text>{{trackBatch ? '切回移动平均' : '开启按批次管理'}}</text>
          </view>
          <view class="gd-act-btn gd-act-btn--ac" bindtap="onOpenMerge">
            <text>合并重复商品</text>
          </view>
        </view>

        <view wx:if="{{aliases.length > 0 || unitConversions.length > 0}}" class="gd-extra">
          <view wx:if="{{aliases.length > 0}}" class="gd-extra__row">
            <text class="gd-extra__k">语音别名</text>
            <view class="gd-tags">
              <text wx:for="{{aliases}}" wx:key="*this" class="gd-tag">{{item}}</text>
            </view>
          </view>
          <view wx:if="{{unitConversions.length > 0}}" class="gd-extra__row">
            <text class="gd-extra__k">单位换算</text>
            <view class="gd-tags">
              <text wx:for="{{unitConversions}}" wx:key="*this" class="gd-tag">{{item}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 在库批次 -->
      <view wx:if="{{trackBatch || batches.length > 0}}" class="card">
        <view class="gd-card-h">
          <text class="gd-sec__t serif">在库批次</text>
          <text class="gd-sec__hint">{{batches.length}} 批</text>
        </view>
        <view wx:if="{{batches.length === 0}}" class="empty">暂无在库批次</view>
        <view wx:else>
          <view wx:for="{{batches}}" wx:key="batchId" class="gd-batch">
            <view class="gd-batch__top">
              <text class="gd-batch__t">{{item.titleText}}</text>
              <text class="gd-batch__tag {{item.isVirtual ? 'gd-batch__tag--virtual' : item.isOpen ? 'gd-batch__tag--open' : ''}}">
                {{item.statusText}}
              </text>
            </view>
            <text class="gd-batch__s">{{item.qtyText}} · 成本 {{item.unitCostText}}</text>
            <text wx:if="{{item.expiryDate}}" class="gd-batch__e">到期 {{item.expiryDate}}</text>
          </view>
        </view>
      </view>

      <!-- 出入库流水台账 -->
      <view class="card">
        <view class="gd-card-h">
          <text class="gd-sec__t serif">出入库流水</text>
          <text class="gd-sec__hint">最近 {{movements.length}} 笔</text>
        </view>
        <view wx:if="{{movements.length === 0}}" class="empty">暂无出入库流水</view>
        <block wx:else>
          <view class="gd-mv-head">
            <text>日期</text>
            <text>业务</text>
            <text class="gd-mv-r">变动</text>
            <text class="gd-mv-r">单号 / 成本</text>
          </view>
          <view wx:for="{{movements}}" wx:key="key" class="gd-mv-row">
            <text class="gd-mv-date">{{item.dateText}}</text>
            <text class="gd-mv-type">{{item.reasonText}}</text>
            <text class="gd-mv-qty gd-mv-r serif-num {{item.isIn ? 'gd-mv-qty--in' : 'gd-mv-qty--out'}}">{{item.qtyText}}</text>
            <text class="gd-mv-sub gd-mv-r">{{item.subText}}</text>
          </view>
        </block>
      </view>
    </block>
  </view>

  <keypad-sheet
    visible="{{kp.visible}}"
    title="{{kp.title}}"
    subtitle="{{kp.subtitle}}"
    value="{{kp.value}}"
    unit="{{kp.unit}}"
    confirmText="{{kp.confirmText}}"
    bind:change="onKpChange"
    bind:confirm="onKpConfirm"
    bind:close="onKpClose"
  />

  <action-sheet
    visible="{{sheet.visible}}"
    title="{{sheet.title}}"
    subtitle="{{sheet.subtitle}}"
    actions="{{sheet.actions}}"
    bind:select="onSheetSelect"
    bind:close="onSheetClose"
  />
</view>
