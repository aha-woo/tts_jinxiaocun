/* 货品详情页 */
.gd-hero__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  flex-wrap: wrap;
}

.gd-hero__title-wrap {
  min-width: 0;
  flex: 1;
}

.gd-hero__title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.25;
}

.gd-hero__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mu);
}

.gd-hero__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.gd-badge {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid var(--ln);
  color: var(--mu);
  background: var(--bg);
  font-weight: 600;
}

.gd-badge--dgr {
  background: var(--dgrb);
  border-color: #e0b9b0;
  color: var(--dgr);
}

.gd-badge--ac {
  background: var(--acs);
  border-color: #eabaa0;
  color: var(--act);
}

.gd-badge--wn {
  background: var(--wnb);
  border-color: var(--wnl);
  color: var(--wn);
}

.gd-badge--vl {
  background: var(--vlb);
  border-color: #cfc6e2;
  color: var(--vl);
}

.gd-kpis {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--ln);
}

.gd-kpi {
  background: var(--bg);
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
}

.gd-kpi__k {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
}

.gd-kpi__v {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.gd-kpi__v--dgr {
  color: var(--dgr);
}

.gd-kpi__v--ac {
  color: var(--act);
}

.gd-sec__h {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.gd-sec__t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.gd-sec__hint {
  font-size: 22rpx;
  color: var(--mu);
}

.gd-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.gd-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--ln);
  border-radius: 18rpx;
  background: var(--bg);
}

.gd-field__lbl {
  font-size: 25rpx;
  color: var(--ink);
  font-weight: 600;
  flex-shrink: 0;
}

.gd-field__in {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  height: 44rpx;
}

.gd-save-btn {
  margin-top: 20rpx !important;
  min-height: 88rpx;
}

.gd-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 16rpx;
}

.gd-extra {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--ln);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.gd-extra__row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.gd-extra__k {
  font-size: 23rpx;
  color: var(--mu);
  flex-shrink: 0;
  padding-top: 4rpx;
}

.gd-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.gd-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  background: var(--bg);
  border: 2rpx solid var(--ln);
  color: var(--ink);
}

.gd-card-h {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 22rpx 24rpx 16rpx;
  border-bottom: 2rpx solid var(--ln);
}

.gd-batch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 2rpx solid var(--ln);
}

.gd-batch:first-child {
  border-top: 0;
}

.gd-batch__l {
  flex: 1;
  min-width: 0;
}

.gd-batch__t {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
}

.gd-batch__s {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
  margin-top: 4rpx;
}

.gd-batch__e {
  display: block;
  font-size: 22rpx;
  color: var(--wn);
  margin-top: 4rpx;
}

.gd-batch__tag {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--mu);
  border: 2rpx solid var(--ln);
  border-radius: var(--r-pill);
  padding: 4rpx 14rpx;
}

.gd-batch__tag--open {
  color: var(--act);
  border-color: var(--act);
  background: var(--acs);
}

.gd-batch__tag--virtual {
  color: var(--dgr);
  border-color: #e0b9b0;
  background: var(--dgrb);
}

/* 出入库流水 4 列表格 */
.gd-mv-head,
.gd-mv-row {
  display: grid;
  grid-template-columns: 100rpx 100rpx 140rpx 1fr;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
}

.gd-mv-head {
  background: #f7f3ea;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--mu);
  border-bottom: 2rpx solid var(--ln);
}

.gd-mv-row {
  border-top: 2rpx solid var(--ln);
  font-size: 24rpx;
}

.gd-mv-row:first-of-type {
  border-top: 0;
}

.gd-mv-r {
  text-align: right;
}

.gd-mv-date {
  color: var(--mu);
  font-variant-numeric: tabular-nums;
}

.gd-mv-type {
  font-weight: 600;
  color: var(--ink);
}

.gd-mv-qty {
  font-weight: 700;
  font-size: 26rpx;
}

.gd-mv-qty--in {
  color: var(--ok);
}

.gd-mv-qty--out {
  color: var(--act);
}

.gd-mv-sub {
  font-size: 22rpx;
  color: var(--mu);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 桌面端 */
@media (min-width: 768px) {
  .gd-hero__title {
    font-size: 22px;
  }

  .gd-hero__sub {
    font-size: 13px;
    margin-top: 4px;
  }

  .gd-badge {
    font-size: 12px;
    padding: 2px 10px;
    border-width: 1px;
  }

  .gd-kpis {
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 16px;
    padding-top: 16px;
    border-top-width: 1px;
  }

  .gd-kpi {
    border-radius: 10px;
    padding: 12px 14px;
  }

  .gd-kpi__k {
    font-size: 12px;
  }

  .gd-kpi__v {
    font-size: 18px;
    margin-top: 3px;
  }

  .gd-sec__t {
    font-size: 16px;
  }

  .gd-sec__hint {
    font-size: 12px;
  }

  .gd-form {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 14px;
  }

  .gd-field {
    border-width: 1px;
    border-radius: 10px;
    padding: 10px 14px;
  }

  .gd-field__lbl {
    font-size: 13px;
  }

  .gd-field__in {
    font-size: 14px;
    height: 24px;
  }

  .gd-save-btn {
    margin-top: 14px !important;
    min-height: 42px;
    width: 220px !important;
  }

  .gd-actions {
    width: 380px;
    gap: 10px;
    margin-top: 12px;
  }

  .gd-card-h {
    padding: 14px 20px 12px;
    border-bottom-width: 1px;
  }

  .gd-batch {
    padding: 12px 20px;
    border-top-width: 1px;
  }

  .gd-batch__t {
    font-size: 14px;
  }

  .gd-batch__s,
  .gd-batch__e {
    font-size: 12px;
  }

  .gd-batch__tag {
    font-size: 11px;
    padding: 2px 10px;
    border-width: 1px;
  }

  .gd-mv-head,
  .gd-mv-row {
    grid-template-columns: 100px 100px 140px 1fr;
    gap: 12px;
    padding: 11px 20px;
  }

  .gd-mv-head {
    font-size: 12px;
    border-bottom-width: 1px;
  }

  .gd-mv-row {
    border-top-width: 1px;
    font-size: 13px;
  }

  .gd-mv-qty {
    font-size: 14px;
  }

  .gd-mv-sub {
    font-size: 12px;
  }
}
