/* 货品详情页 */
.gd-hero__top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  flex-wrap: wrap;
}

.gd-hero__title-wrap {
  min-width: 0;
  flex: 1;
}

.gd-hero__title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.25;
}

.gd-hero__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--mu);
}

.gd-hero__badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.gd-badge {
  font-size: 21rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid var(--ln);
  color: var(--mu);
  background: var(--bg);
  font-weight: 600;
  white-space: nowrap;
}

.gd-badge--dgr {
  background: var(--dgrb);
  border-color: #e0b9b0;
  color: var(--dgr);
}

.gd-badge--ac {
  background: var(--acs);
  border-color: #eabaa0;
  color: var(--act);
}

.gd-badge--wn {
  background: var(--wnb);
  border-color: var(--wnl);
  color: var(--wn);
}

.gd-badge--vl {
  background: var(--vlb);
  border-color: #cfc6e2;
  color: var(--vl);
}

.gd-kpis {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--ln);
}

.gd-kpi {
  background: var(--bg);
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
}

.gd-kpi__k {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
}

.gd-kpi__v {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.gd-kpi__v--dgr {
  color: var(--dgr);
}

.gd-kpi__v--ac {
  color: var(--act);
}

.gd-sec__h {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.gd-sec__t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.gd-sec__hint {
  font-size: 22rpx;
  color: var(--mu);
}

/* 参数列表行 */
.gd-params {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.gd-param {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--ln);
  border-radius: 18rpx;
  background: var(--bg);
}

.gd-param--tap:active {
  background: var(--acs);
  border-color: #eabaa0;
}

.gd-param__l {
  flex: 1;
  min-width: 0;
}

.gd-param__t {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.gd-param__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--mu);
}

.gd-param__r {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.gd-param__v {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.gd-param__v--wn {
  color: var(--wn);
}

.gd-param__edit {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--act);
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  background: var(--acs);
  border: 2rpx solid #eabaa0;
  white-space: nowrap;
}

/* 管理操作按钮（用 view 等宽 2 列，杜绝原生 button 宽度溢出） */
.gd-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
  width: 100%;
  box-sizing: border-box;
}

.gd-act-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 78rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  background: var(--bg);
  border: 2rpx solid var(--ln);
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
  white-space: nowrap;
}

.gd-act-btn:active {
  background: #ebe3d3;
}

.gd-act-btn--ac {
  background: var(--acs);
  border-color: #eabaa0;
  color: var(--act);
}

.gd-act-btn--ac:active {
  background: #f6d5c1;
}

.gd-extra {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--ln);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.gd-extra__row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.gd-extra__k {
  font-size: 23rpx;
  color: var(--mu);
  flex-shrink: 0;
  padding-top: 4rpx;
}

.gd-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.gd-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill);
  background: var(--bg);
  border: 2rpx solid var(--ln);
  color: var(--ink);
}

.gd-card-h {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 22rpx 24rpx 16rpx;
  border-bottom: 2rpx solid var(--ln);
}

/* 在库批次行：标题 + 紧凑小角标同行，不再放右端变形大椭圆 */
.gd-batch {
  padding: 20rpx 24rpx;
  border-top: 2rpx solid var(--ln);
}

.gd-batch:first-child {
  border-top: 0;
}

.gd-batch__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.gd-batch__t {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.gd-batch__tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  height: 36rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--mu);
  border: 2rpx solid var(--ln);
  border-radius: 8rpx;
}

.gd-batch__tag--open {
  color: var(--act);
  border-color: #eabaa0;
  background: var(--acs);
}

.gd-batch__tag--virtual {
  color: var(--dgr);
  border-color: #e0b9b0;
  background: var(--dgrb);
}

.gd-batch__s {
  display: block;
  font-size: 23rpx;
  color: var(--mu);
  margin-top: 6rpx;
}

.gd-batch__e {
  display: block;
  font-size: 22rpx;
  color: var(--wn);
  margin-top: 4rpx;
}

/* 出入库流水 4 列表格 */
.gd-mv-head,
.gd-mv-row {
  display: grid;
  grid-template-columns: 100rpx 100rpx 140rpx 1fr;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
}

.gd-mv-head {
  background: #f7f3ea;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--mu);
  border-bottom: 2rpx solid var(--ln);
}

.gd-mv-row {
  border-top: 2rpx solid var(--ln);
  font-size: 24rpx;
}

.gd-mv-row:first-of-type {
  border-top: 0;
}

.gd-mv-r {
  text-align: right;
}

.gd-mv-date {
  color: var(--mu);
  font-variant-numeric: tabular-nums;
}

.gd-mv-type {
  font-weight: 600;
  color: var(--ink);
}

.gd-mv-qty {
  font-weight: 700;
  font-size: 26rpx;
}

.gd-mv-qty--in {
  color: var(--ok);
}

.gd-mv-qty--out {
  color: var(--act);
}

.gd-mv-sub {
  font-size: 22rpx;
  color: var(--mu);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 桌面端 */
@media (min-width: 768px) {
  .gd-hero__title {
    font-size: 22px;
  }

  .gd-hero__sub {
    font-size: 13px;
    margin-top: 4px;
  }

  .gd-badge {
    font-size: 12px;
    padding: 2px 10px;
    border-width: 1px;
  }

  .gd-kpis {
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 16px;
    padding-top: 16px;
    border-top-width: 1px;
  }

  .gd-kpi {
    border-radius: 10px;
    padding: 12px 14px;
  }

  .gd-kpi__k {
    font-size: 12px;
  }

  .gd-kpi__v {
    font-size: 18px;
    margin-top: 3px;
  }

  .gd-sec__t {
    font-size: 16px;
  }

  .gd-sec__hint {
    font-size: 12px;
  }

  .gd-params {
    gap: 10px;
    margin-top: 14px;
  }

  .gd-param {
    border-width: 1px;
    border-radius: 10px;
    padding: 12px 16px;
  }

  .gd-param--tap {
    cursor: pointer;
  }

  .gd-param--tap:hover {
    background: #faf6ee;
  }

  .gd-param__t {
    font-size: 14px;
  }

  .gd-param__sub {
    font-size: 12px;
    margin-top: 2px;
  }

  .gd-param__v {
    font-size: 15px;
  }

  .gd-param__edit {
    font-size: 12px;
    padding: 2px 10px;
    border-width: 1px;
  }

  .gd-actions {
    width: 380px;
    gap: 10px;
    margin-top: 14px;
  }

  .gd-act-btn {
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    font-size: 13px;
    cursor: pointer;
  }

  .gd-card-h {
    padding: 14px 20px 12px;
    border-bottom-width: 1px;
  }

  .gd-batch {
    padding: 12px 20px;
    border-top-width: 1px;
  }

  .gd-batch__t {
    font-size: 14px;
  }

  .gd-batch__tag {
    height: 20px;
    padding: 0 8px;
    font-size: 11px;
    border-width: 1px;
  }

  .gd-batch__s,
  .gd-batch__e {
    font-size: 12px;
  }

  .gd-mv-head,
  .gd-mv-row {
    grid-template-columns: 100px 100px 140px 1fr;
    gap: 12px;
    padding: 11px 20px;
  }

  .gd-mv-head {
    font-size: 12px;
    border-bottom-width: 1px;
  }

  .gd-mv-row {
    border-top-width: 1px;
    font-size: 13px;
  }

  .gd-mv-qty {
    font-size: 14px;
  }

  .gd-mv-sub {
    font-size: 12px;
  }
}
