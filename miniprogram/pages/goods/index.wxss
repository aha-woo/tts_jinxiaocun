/* 货品页：工具栏 + 表格/卡片一键切换 + 汇总条 + 传统进销存表格 */
.goods-bar {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.goods-bar__top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.goods-search {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--sf);
  border: 2rpx solid var(--ln);
  border-radius: var(--r-pill);
  padding: 10rpx 20rpx;
}

.goods-search__in {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
  height: 44rpx;
}

.goods-search__clr {
  font-size: 24rpx;
  color: var(--act);
  font-weight: 600;
  white-space: nowrap;
}

/* 表格 / 卡片 视图切换 */
.view-switch {
  display: inline-flex;
  align-items: center;
  background: #eae3d5;
  border-radius: var(--r-pill);
  padding: 4rpx;
  flex-shrink: 0;
}

.view-switch__btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: 23rpx;
  color: var(--mu);
  font-weight: 600;
  white-space: nowrap;
}

.view-switch__btn--on {
  background: var(--sf);
  color: var(--ink);
  box-shadow: var(--sh-1);
}

.goods-bar__sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.chips {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.chip {
  border: 2rpx solid var(--ln);
  background: var(--sf);
  border-radius: var(--r-pill);
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--ink);
}

.chip--on {
  background: var(--ink);
  color: var(--sf);
  border-color: var(--ink);
}

.goods-count-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: var(--r-pill);
  background: var(--ink);
  color: var(--sf);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* 汇总条 */
.gsum {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 18rpx 8rpx;
}

.gsum__item {
  text-align: center;
  padding: 0 8rpx;
}

.gsum__item + .gsum__item {
  border-left: 2rpx solid var(--ln);
}

.gsum__k {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
}

.gsum__v {
  display: block;
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.gsum__v--warn {
  color: var(--dgr);
}

.gsum__v--ac {
  color: var(--act);
}

/* 传统多列表格（手机端左列固定 + 横向滑动） */
.gtbl-wrap {
  width: 100%;
  overflow: hidden;
}

.gtbl {
  min-width: 980rpx;
}

.gtbl--nocost {
  min-width: 720rpx;
}

.gtbl__head,
.gtbl__row {
  display: grid;
  grid-template-columns: 260rpx 150rpx 150rpx 130rpx 170rpx 120rpx;
  align-items: center;
}

.gtbl--nocost .gtbl__head,
.gtbl--nocost .gtbl__row {
  grid-template-columns: 280rpx 160rpx 150rpx 130rpx;
}

.gtbl__head {
  background: #f7f3ea;
  border-bottom: 2rpx solid var(--ln);
}

.gtbl__th {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 18rpx 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--mu);
  white-space: nowrap;
}

.gtbl__th--right {
  justify-content: flex-end;
}

.gtbl__th--center {
  justify-content: center;
}

.gtbl__th--on {
  color: var(--ink);
}

.gtbl__sort {
  color: var(--act);
  font-weight: 700;
}

.gtbl__row {
  border-top: 2rpx solid var(--ln);
  background: var(--sf);
}

.gtbl__row:first-of-type {
  border-top: 0;
}

.gtbl__row:active,
.gtbl__row:active .gtbl__sticky {
  background: var(--acs);
}

.gtbl__td {
  padding: 20rpx 16rpx;
  font-size: 25rpx;
  color: var(--ink);
  white-space: nowrap;
}

.gtbl__td--right {
  text-align: right;
}

.gtbl__td--center {
  text-align: center;
}

.gtbl__sticky {
  position: sticky;
  left: 0;
  z-index: 2;
  background: var(--sf);
  box-shadow: 4rpx 0 10rpx -6rpx rgba(31, 27, 22, 0.14);
}

.gtbl__sticky--head {
  background: #f7f3ea;
  z-index: 3;
}

.gtbl__name-cell {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.gtbl__name {
  font-weight: 700;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.gtbl__tags {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.gtbl__tag {
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  line-height: 1.3;
}

.gtbl__tag--neg {
  background: var(--dgrb);
  color: var(--dgr);
}

.gtbl__tag--low {
  background: var(--acs);
  color: var(--act);
}

.gtbl__tag--batch {
  background: var(--vlb);
  color: var(--vl);
}

.gtbl__stock {
  font-weight: 700;
  font-size: 28rpx;
}

.gtbl__unit {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--mu);
  margin-left: 4rpx;
}

.gtbl__num {
  font-variant-numeric: tabular-nums;
  font-size: 24rpx;
  color: var(--ink);
}

.gtbl__val {
  font-weight: 600;
}

.gtbl__mode {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--r-pill);
  background: #f2ece0;
  color: var(--mu);
  font-weight: 600;
}

.gtbl__mode--batch {
  background: var(--vlb);
  color: var(--vl);
}

.gtbl__foot {
  padding: 14rpx 20rpx;
  border-top: 2rpx solid var(--ln);
  background: #faf6ee;
  font-size: 21rpx;
  color: var(--mu);
  text-align: center;
}

.gtbl__foot-wide {
  display: none;
}

/* 卡片模式 */
.gi {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-top: 2rpx solid var(--ln);
  width: 100%;
  text-align: left;
}

.gi:first-child {
  border-top: 0;
}

.gi:active {
  background: var(--acs);
}

.gi__md {
  flex: 1;
  min-width: 0;
}

.gi__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.gi__name {
  font-weight: 700;
  font-size: 30rpx;
}

.gi__pill {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid var(--ln);
  color: var(--mu);
}

.gi__pill--neg {
  color: var(--dgr);
  border-color: #e0b9b0;
  background: var(--dgrb);
}

.gi__meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  margin-top: 8rpx;
}

.gi__meta {
  font-size: 22rpx;
  color: var(--mu);
  font-variant-numeric: tabular-nums;
}

.gi__sub--warn {
  color: var(--wn);
  font-weight: 700;
}

.gi__rt-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.gi__rt {
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-weight: 700;
  font-size: 34rpx;
  text-align: right;
  white-space: nowrap;
}

.gi__rt--low {
  color: var(--ac);
}

.gi__rt--neg {
  color: var(--dgr);
}

.gi__unit {
  font-family: -apple-system, 'PingFang SC', sans-serif;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--mu);
  margin-left: 4rpx;
}

.gi__act-link {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--act);
}

/* 电脑版微信大屏（>=768px）：工具栏平铺 + 表格铺满无需滚动 */
@media (min-width: 768px) {
  .goods-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .goods-bar__top {
    order: 2;
    gap: 10px;
  }

  .goods-bar__sub {
    order: 1;
    flex: 1;
    gap: 12px;
  }

  .goods-search {
    width: 240px;
    flex: none;
    border-width: 1px;
    padding: 6px 14px;
  }

  .goods-search__in {
    font-size: 13px;
    height: 24px;
  }

  .goods-search__clr {
    font-size: 12px;
    cursor: pointer;
  }

  .view-switch {
    padding: 3px;
  }

  .view-switch__btn {
    padding: 5px 12px;
    font-size: 12px;
    gap: 5px;
    cursor: pointer;
  }

  .chips {
    gap: 8px;
  }

  .chip {
    border-width: 1px;
    padding: 5px 14px;
    font-size: 13px;
    cursor: pointer;
  }

  .goods-count-btn {
    padding: 6px 14px;
    font-size: 13px;
    gap: 6px;
    cursor: pointer;
  }

  .gsum {
    padding: 14px 8px;
  }

  .gsum__item + .gsum__item {
    border-left-width: 1px;
  }

  .gsum__k {
    font-size: 12px;
  }

  .gsum__v {
    font-size: 20px;
    margin-top: 2px;
  }

  .gtbl,
  .gtbl--nocost {
    min-width: 100%;
    width: 100%;
  }

  .gtbl__head,
  .gtbl__row {
    grid-template-columns: minmax(200px, 2.2fr) minmax(110px, 1fr) minmax(110px, 1fr) minmax(100px, 0.9fr) minmax(120px, 1.1fr) 90px;
  }

  .gtbl--nocost .gtbl__head,
  .gtbl--nocost .gtbl__row {
    grid-template-columns: minmax(240px, 2.5fr) minmax(120px, 1fr) minmax(120px, 1fr) 100px;
  }

  .gtbl__head {
    border-bottom-width: 1px;
  }

  .gtbl__th {
    padding: 10px 16px;
    font-size: 12px;
    cursor: pointer;
  }

  .gtbl__row {
    border-top-width: 1px;
    cursor: pointer;
  }

  .gtbl__row:hover,
  .gtbl__row:hover .gtbl__sticky {
    background: #faf6ee;
  }

  .gtbl__td {
    padding: 12px 16px;
    font-size: 13px;
  }

  .gtbl__sticky {
    position: static;
    box-shadow: none;
  }

  .gtbl__name {
    font-size: 14px;
  }

  .gtbl__tag {
    font-size: 11px;
    padding: 1px 6px;
  }

  .gtbl__stock {
    font-size: 16px;
  }

  .gtbl__unit {
    font-size: 12px;
  }

  .gtbl__num {
    font-size: 13px;
  }

  .gtbl__mode {
    font-size: 12px;
    padding: 2px 10px;
  }

  .gtbl__foot {
    padding: 10px 16px;
    border-top-width: 1px;
    font-size: 12px;
  }

  .gtbl__foot-mobile {
    display: none;
  }

  .gtbl__foot-wide {
    display: inline;
  }

  .gi {
    padding: 14px 20px;
    border-top-width: 1px;
    cursor: pointer;
  }

  .gi:hover {
    background: #faf6ee;
  }

  .gi__name {
    font-size: 15px;
  }

  .gi__pill {
    font-size: 11px;
    padding: 1px 8px;
    border-width: 1px;
  }

  .gi__meta {
    font-size: 12px;
  }

  .gi__rt {
    font-size: 18px;
  }

  .gi__unit {
    font-size: 12px;
  }

  .gi__act-link {
    font-size: 12px;
  }
}
