/* 货品页：手机端 chips + 列表行；电脑版微信大屏（>=768px）搜索栏 + 4 列库存表 */
.goods-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.goods-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--sf);
  border: 2rpx solid var(--ln);
  border-radius: var(--r-pill);
  padding: 10rpx 22rpx;
}

.goods-search__in {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink);
  height: 44rpx;
}

.goods-search__clr {
  font-size: 24rpx;
  color: var(--act);
  font-weight: 600;
  white-space: nowrap;
}

.chips {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.chip {
  border: 2rpx solid var(--ln);
  background: var(--sf);
  border-radius: var(--r-pill);
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.chip--on {
  background: var(--ink);
  color: var(--sf);
  border-color: var(--ink);
}

.gi__cost-col,
.gi__act {
  display: none;
}

.gi {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 24rpx;
  border-top: 2rpx solid var(--ln);
  width: 100%;
  text-align: left;
}

.gi:first-child {
  border-top: 0;
}

.gi:active {
  background: var(--acs);
}

.gi__md {
  flex: 1;
  min-width: 0;
}

.gi__top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.gi__name {
  font-weight: 700;
  font-size: 30rpx;
}

.gi__pill {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  border: 2rpx solid var(--ln);
  color: var(--mu);
}

.gi__pill--neg {
  color: var(--dgr);
  border-color: #e0b9b0;
  background: var(--dgrb);
}

.gi__sub {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  margin-top: 4rpx;
}

.gi__sub--warn {
  color: var(--wn);
  font-weight: 700;
}

.gi__rt {
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-weight: 700;
  font-size: 34rpx;
  text-align: right;
  white-space: nowrap;
}

.gi__rt--low {
  color: var(--ac);
}

.gi__rt--neg {
  color: var(--dgr);
}

.gi__unit {
  font-family: -apple-system, 'PingFang SC', sans-serif;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--mu);
  margin-left: 4rpx;
}

/* 电脑版微信大屏（>=768px）：工具栏横向排列 + 4 列库存表 */
@media (min-width: 768px) {
  .goods-bar {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .goods-bar__cta {
    order: 3;
    width: auto !important;
    min-width: 210px;
    margin-left: auto !important;
  }

  .goods-search {
    order: 2;
    width: 240px;
    border-width: 1px;
    padding: 6px 14px;
  }

  .goods-search__in {
    font-size: 13px;
    height: 24px;
  }

  .goods-search__clr {
    font-size: 12px;
    cursor: pointer;
  }

  .chips {
    order: 1;
    gap: 8px;
  }

  .chip {
    border-width: 1px;
    padding: 6px 14px;
    font-size: 13px;
    cursor: pointer;
  }

  .gtbl__head {
    grid-template-columns: minmax(220px, 2.2fr) minmax(160px, 1.4fr) 130px 110px;
    gap: 16px;
  }

  .gtbl__h-right {
    text-align: right;
  }

  .gi {
    display: grid;
    grid-template-columns: minmax(220px, 2.2fr) minmax(160px, 1.4fr) 130px 110px;
    gap: 16px;
    padding: 13px 20px;
    border-top-width: 1px;
    cursor: pointer;
  }

  .gi:hover {
    background: #faf6ee;
  }

  .gi__sub--mobile {
    display: none;
  }

  .gi__cost-col {
    display: block;
    min-width: 0;
  }

  .gi__cost-txt {
    font-size: 13px;
    color: var(--mu);
  }

  .gi__name {
    font-size: 15px;
  }

  .gi__pill {
    font-size: 11px;
    padding: 1px 8px;
    border-width: 1px;
  }

  .gi__rt {
    font-size: 18px;
  }

  .gi__unit {
    font-size: 12px;
    margin-left: 3px;
  }

  .gi__act {
    display: block;
    text-align: right;
  }

  .gi__act-link {
    font-size: 12px;
    font-weight: 600;
    color: var(--act);
  }
}
