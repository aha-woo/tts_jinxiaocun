/* 手动记账（方案 A）：白底卡片 + 顶部一句说明，信息密度低、字号大 */
.page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: var(--s-3);
  box-sizing: border-box;
}

.tip {
  background: var(--c-brand-soft);
  color: var(--c-brand-dark);
  border-radius: var(--r-btn);
  padding: var(--s-2) var(--s-3);
  font-size: var(--f-small);
  line-height: 1.6;
  margin-bottom: var(--s-3);
}

.preview-card {
  background: var(--c-white);
  border-radius: var(--r-card);
  padding: var(--s-3) var(--s-4);
  margin-bottom: var(--s-3);
}

.preview-card__label {
  font-size: var(--f-small);
  color: var(--c-ink-3);
  margin-bottom: 6rpx;
}

.preview-card__text {
  font-size: var(--f-body);
  color: var(--c-ink);
  line-height: 1.6;
}

.error {
  padding: var(--s-2) var(--s-3);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
  line-height: 1.6;
}

.submitting {
  margin-top: var(--s-2);
  text-align: center;
  font-size: var(--f-small);
  color: var(--c-brand-dark);
}
