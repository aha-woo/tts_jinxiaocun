.page {
  min-height: 100vh;
  background: #f4f6f8;
  padding: 20rpx;
  box-sizing: border-box;
}

.hint {
  background: #e8f0ff;
  color: #1554b5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.panel__title {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.preview {
  font-size: 30rpx;
  color: #1f2328;
}

.error {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fde8e8;
  color: #b42318;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.submitting {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #1f6feb;
}
