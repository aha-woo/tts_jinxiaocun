/* 手动记账 */
.hint {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  line-height: 1.6;
}

.pad {
  padding: 24rpx;
}

.c-title {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.said {
  background: var(--bg);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 30rpx;
  line-height: 1.55;
}

.manual-photo-btn {
  margin: 0;
  padding: 12rpx 24rpx;
  border-radius: var(--r-pill);
  background: var(--ac);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.manual-photo-btn:active {
  background: var(--act);
}

.manual-photo-btn__in {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
