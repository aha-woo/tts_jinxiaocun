/* 管理台（方案 A）：左导航 + 右内容；窄屏回落成横向标签；大屏结构化表格 + KPI 卡片 */
.console {
  display: flex;
  align-items: stretch;
  min-height: 100vh;
  background: var(--c-bg);
}

.console--narrow {
  flex-direction: column;
}

.content {
  flex: 1;
  min-width: 0;
  padding: var(--s-3) var(--s-3) var(--s-4);
  box-sizing: border-box;
}

.content__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--s-2);
}

.content__title {
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: var(--f-h1);
  font-weight: 700;
  color: var(--c-ink);
}

.content__role {
  font-size: var(--f-small);
  color: var(--c-ink-3);
}

.panel {
  background: var(--c-white);
  border-radius: var(--r-card);
  padding: var(--s-3) var(--s-4);
  margin-bottom: var(--s-2);
  border: 1rpx solid var(--c-line);
}

.panel__title {
  font-size: var(--f-body);
  font-weight: 700;
  color: var(--c-ink);
  margin: var(--s-1) 0 var(--s-2);
}

.panel__title:first-child {
  margin-top: 0;
}

.row {
  font-size: var(--f-small);
  color: var(--c-ink-2);
  padding: var(--s-2) 0;
  border-bottom: 1rpx solid var(--c-line);
  line-height: 1.6;
  word-break: break-all;
}

.row:last-child {
  border-bottom: none;
}

/* 结构化表格（手机端紧凑，桌面端宽表） */
.atbl {
  border: 1rpx solid var(--c-line);
  border-radius: 16rpx;
  overflow: hidden;
}

.atbl__head {
  display: grid;
  background: #f7f3ea;
  color: var(--c-ink-3);
  font-size: 22rpx;
  font-weight: 600;
  padding: 14rpx 18rpx;
  gap: 12rpx;
  border-bottom: 1rpx solid var(--c-line);
}

.atbl__row {
  display: grid;
  align-items: center;
  padding: 16rpx 18rpx;
  gap: 12rpx;
  font-size: 24rpx;
  border-top: 1rpx solid var(--c-line);
}

.atbl__row:nth-child(2) {
  border-top: 0;
}

.atbl__row--rev {
  opacity: 0.6;
}

.atbl__head--stock,
.atbl__row--stock {
  grid-template-columns: 1.5fr 1fr 0.9fr 1fr 0.9fr;
}

.atbl__head--docs,
.atbl__row--docs {
  grid-template-columns: 1.2fr 1fr 0.8fr 0.9fr 1fr 0.8fr;
}

.atbl__head--top,
.atbl__row--top {
  grid-template-columns: 64rpx 1.6fr 0.9fr 1fr;
}

.atbl__strong {
  font-weight: 600;
  color: var(--c-ink);
}

.atbl__muted {
  color: var(--c-ink-3);
}

.atbl__num {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.atbl__danger {
  color: var(--c-danger);
  font-weight: 700;
}

.atbl__tag {
  font-size: 20rpx;
  color: var(--c-ink-3);
}

.atbl__tag--danger {
  color: var(--c-danger);
  font-weight: 600;
}

/* 报表卡片网格 */
.rep-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.rep-card {
  background: var(--c-bg);
  border: 1rpx solid var(--c-line);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
}

.rep-card__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.rep-card__title {
  font-weight: 700;
  font-size: 28rpx;
  color: var(--c-ink);
}

.rep-card__date {
  font-size: 20rpx;
  color: var(--c-ink-3);
}

.rep-card__kv {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 6rpx 0;
}

.rep-card__k {
  font-size: 24rpx;
  color: var(--c-ink-3);
}

.rep-card__v {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-ink);
}

.rep-card__v--accent {
  color: var(--c-brand);
}

.rep-card__foot {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--c-line);
  font-size: 20rpx;
  color: var(--c-ink-3);
}

.usage-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.usage-box {
  background: var(--c-bg);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--c-line);
}

.muted {
  font-size: 22rpx;
  color: var(--c-ink-3);
  margin-top: var(--s-1);
  line-height: 1.5;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  margin: var(--s-2) 0;
}

.row-btn {
  height: 88rpx;
  font-size: var(--f-small);
  padding: 0 var(--s-3);
  margin: 0 var(--s-2) var(--s-2) 0;
}

.task {
  border-bottom: 1rpx solid var(--c-line);
  padding: var(--s-2) 0;
}

.task__title {
  font-size: var(--f-body);
  font-weight: 600;
  color: var(--c-ink);
}

.task__meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--c-ink-3);
}

.task__actions {
  display: flex;
  margin-top: var(--s-2);
}

.loading {
  text-align: center;
  font-size: var(--f-small);
  color: var(--c-ink-3);
  padding: var(--s-3) 0;
}

.message {
  padding: var(--s-2) var(--s-3);
  background: var(--c-brand-soft);
  color: var(--c-brand-dark);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
  margin-top: var(--s-2);
}

.error {
  padding: var(--s-2) var(--s-3);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
  margin-top: var(--s-2);
}

/* 电脑版微信大屏（>=768px）：清晰 px 桌面表格、3 列 KPI 报表卡、2 列用量卡 */
@media (min-width: 768px) {
  side-nav {
    display: flex;
    flex-shrink: 0;
  }

  .content {
    max-width: 1180px;
    padding: 24px 30px 48px;
  }

  .content__head {
    margin-bottom: 16px;
  }

  .content__title {
    font-size: 24px;
  }

  .content__role {
    font-size: 13px;
  }

  .panel {
    border-radius: 14px;
    padding: 20px 24px;
    margin-bottom: 16px;
  }

  .panel__title {
    font-size: 16px;
    margin: 0 0 12px;
  }

  .row {
    font-size: 14px;
    padding: 10px 0;
  }

  .atbl {
    border-radius: 10px;
  }

  .atbl__head {
    font-size: 12px;
    padding: 10px 14px;
    gap: 12px;
  }

  .atbl__row {
    font-size: 13px;
    padding: 11px 14px;
    gap: 12px;
  }

  .atbl__row:hover {
    background: #faf6ee;
  }

  .atbl__head--top,
  .atbl__row--top {
    grid-template-columns: 56px 2fr 120px 140px;
  }

  .atbl__tag {
    font-size: 12px;
  }

  .rep-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .rep-card {
    border-radius: 12px;
    padding: 16px 18px;
  }

  .rep-card__title {
    font-size: 15px;
  }

  .rep-card__date {
    font-size: 12px;
  }

  .rep-card__k {
    font-size: 13px;
  }

  .rep-card__v {
    font-size: 18px;
  }

  .rep-card__foot {
    font-size: 12px;
    margin-top: 8px;
    padding-top: 8px;
  }

  .usage-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .usage-box {
    border-radius: 12px;
    padding: 16px 18px;
  }

  .row-btn {
    height: 40px;
    font-size: 13px;
    padding: 0 16px;
    border-radius: 10px;
    cursor: pointer;
  }

  .task {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
  }

  .task__title {
    font-size: 15px;
  }

  .task__meta {
    font-size: 12px;
  }

  .task__actions {
    margin-top: 0;
    flex-shrink: 0;
  }
}
