/* 管理台（方案 A）：左导航 + 右内容；窄屏回落成横向标签 */
.console {
  display: flex;
  align-items: stretch;
  min-height: 100vh;
  background: var(--c-bg);
}

.console--narrow {
  flex-direction: column;
}

.content {
  flex: 1;
  min-width: 0;
  padding: var(--s-3) var(--s-3) var(--s-4);
  box-sizing: border-box;
}

.content__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--s-2);
}

.content__title {
  font-size: var(--f-h1);
  font-weight: 800;
  color: var(--c-ink);
}

.content__role {
  font-size: var(--f-small);
  color: var(--c-ink-3);
}

.panel {
  background: var(--c-white);
  border-radius: var(--r-card);
  padding: var(--s-3) var(--s-4);
  margin-bottom: var(--s-2);
  border: 1rpx solid var(--c-line);
}

.panel__title {
  font-size: var(--f-body);
  font-weight: 700;
  color: var(--c-ink);
  margin: var(--s-1) 0 var(--s-2);
}

.panel__title:first-child {
  margin-top: 0;
}

.row {
  font-size: var(--f-small);
  color: var(--c-ink-2);
  padding: var(--s-2) 0;
  border-bottom: 1rpx solid var(--c-line);
  line-height: 1.6;
  word-break: break-all;
}

.row:last-child {
  border-bottom: none;
}

.muted {
  font-size: 22rpx;
  color: var(--c-ink-3);
  margin-top: var(--s-1);
  line-height: 1.5;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  margin: var(--s-2) 0;
}

.row-btn {
  height: 88rpx;
  font-size: var(--f-small);
  padding: 0 var(--s-3);
  margin: 0 var(--s-2) var(--s-2) 0;
}

.task {
  border-bottom: 1rpx solid var(--c-line);
  padding: var(--s-2) 0;
}

.task__title {
  font-size: var(--f-body);
  font-weight: 600;
  color: var(--c-ink);
}

.task__meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--c-ink-3);
}

.task__actions {
  display: flex;
  margin-top: var(--s-2);
}

.loading {
  text-align: center;
  font-size: var(--f-small);
  color: var(--c-ink-3);
  padding: var(--s-3) 0;
}

.message {
  padding: var(--s-2) var(--s-3);
  background: var(--c-brand-soft);
  color: var(--c-brand-dark);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
  margin-top: var(--s-2);
}

.error {
  padding: var(--s-2) var(--s-3);
  background: var(--c-danger-soft);
  color: var(--c-danger);
  border-radius: var(--r-btn);
  font-size: var(--f-small);
  margin-top: var(--s-2);
}
