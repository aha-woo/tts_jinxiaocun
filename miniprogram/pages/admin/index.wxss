/* 双栏：左导航固定 + 右内容滚动；窄屏回落单栏（.console--narrow） */
.console {
  display: flex;
  align-items: stretch;
  min-height: 100vh;
  background: #f4f6f8;
}

.console--narrow {
  flex-direction: column;
}

.content {
  flex: 1;
  min-width: 0;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.content__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.content__title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2328;
}

.content__role {
  font-size: 22rpx;
  color: #6b7280;
}

.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.panel__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2328;
  margin: 8rpx 0 12rpx;
}

.row {
  font-size: 24rpx;
  color: #4b5563;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f4f6f8;
  word-break: break-all;
}

.actions {
  display: flex;
  margin: 12rpx 0;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #f1f3f5;
  color: #1f2328;
  font-size: 26rpx;
}

.btn--primary {
  background: #1f6feb;
  color: #fff;
}

.task {
  border-bottom: 1rpx solid #f4f6f8;
  padding: 16rpx 0;
}

.task__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2328;
}

.task__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa4ae;
}

.task__actions {
  display: flex;
  margin-top: 12rpx;
}

.muted {
  font-size: 22rpx;
  color: #9aa4ae;
  margin-top: 8rpx;
}

.loading {
  text-align: center;
  font-size: 24rpx;
  color: #9aa4ae;
  padding: 20rpx 0;
}

.message {
  padding: 16rpx 20rpx;
  background: #e6f6ee;
  color: #0f7b4c;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.error {
  padding: 16rpx 20rpx;
  background: #fde8e8;
  color: #b42318;
  border-radius: 12rpx;
  font-size: 24rpx;
  margin-top: 12rpx;
}
