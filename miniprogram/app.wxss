/* ==========================================================================
 * 设计系统 v2 · 方向 A「暖纸账本」
 * 依据 docs/index-v2/index.html 原型；页面只读 token，禁止写死色值/字号。
 * 1px ≈ 2rpx（750 设计宽）。
 * ========================================================================== */

page {
  /* 纸与墨 */
  --bg: #f5f1e8;
  --sf: #fffdf8;
  --ink: #1f1b16;
  --mu: #7c7367;
  --ln: #e7dfd1;
  /* 陶土橙：主操作、卖货 */
  --ac: #c2410c;
  --acs: #fbe6da;
  --act: #a8380a;
  /* 赊欠琥珀 */
  --wn: #94560a;
  --wnb: #fbefd6;
  --wnl: #ebcf95;
  /* 其他语义 */
  --ok: #355a35;
  --okb: #e6eee4;
  --vl: #4a3d73;
  --vlb: #e9e4f1;
  --dgr: #8a3b2e;
  --dgrb: #f3e3e0;
  /* 半径与阴影 */
  --r-card: 28rpx;
  --r-btn: 24rpx;
  --r-pill: 999rpx;
  --sh-1: 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
  --sh-2: 0 16rpx 32rpx -16rpx rgba(60, 40, 10, 0.3);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Noto Sans SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  font: inherit;
  color: inherit;
  background: none;
  border: 0;
  padding: 0;
  line-height: normal;
}

button::after {
  border: none;
}

/* 排版：标题用衬线，数字用衬线 + 等宽数 */
.serif {
  font-family: 'Songti SC', 'Noto Serif SC', serif;
}

.serif-num {
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-variant-numeric: tabular-nums;
}

.mu {
  color: var(--mu);
}

/* 卡片 */
.card {
  background: var(--sf);
  border: 2rpx solid var(--ln);
  border-radius: var(--r-card);
  overflow: hidden;
}

/* 分段控件 */
.seg {
  display: flex;
  background: #eae3d5;
  border-radius: var(--r-pill);
  padding: 6rpx;
}

.seg__item {
  flex: 1;
  padding: 10rpx 16rpx;
  border-radius: var(--r-pill);
  color: #6b6257;
  font-size: 26rpx;
  text-align: center;
  white-space: nowrap;
}

.seg__item--on {
  background: var(--sf);
  color: var(--ink);
  font-weight: 700;
  box-shadow: var(--sh-1);
}

/* 页头 */
.hello {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16rpx;
}

.hello__t {
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hello__sub {
  display: block;
  font-size: 24rpx;
  color: var(--mu);
  margin-top: 6rpx;
}

/* 待处理角标 */
.pbadge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--sf);
  border: 2rpx solid var(--ln);
  border-radius: var(--r-pill);
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.pbadge__n {
  background: var(--ac);
  color: #fff;
  border-radius: var(--r-pill);
  min-width: 36rpx;
  height: 36rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  padding: 0 8rpx;
}

/* 三数卡 */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 24rpx 8rpx;
}

.stats__i {
  text-align: center;
}

.stats__i + .stats__i {
  border-left: 2rpx solid var(--ln);
}

.stats__k {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
}

.stats__v {
  display: block;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.stats__v--owe {
  color: var(--wn);
}

/* 提醒条 */
.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: var(--wnb);
  border: 2rpx solid var(--wnl);
  color: var(--wn);
  font-size: 26rpx;
  font-weight: 700;
  text-align: left;
  width: 100%;
}

.bar__more {
  white-space: nowrap;
  text-decoration: underline;
}

/* 今日流水 */
.flow {
  padding: 4rpx 24rpx 8rpx;
}

.flow__h {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--mu);
  padding: 20rpx 0 8rpx;
}

.fi {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--ln);
  width: 100%;
  text-align: left;
}

.fi:first-of-type {
  border-top: 0;
}

.fi__tm {
  font-size: 22rpx;
  color: var(--mu);
  width: 88rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.fi__md {
  flex: 1;
  min-width: 0;
}

.fi__md b {
  font-weight: 500;
  font-size: 28rpx;
}

.fi__md small {
  display: block;
  font-size: 22rpx;
  color: var(--mu);
  margin-top: 2rpx;
}

.fi__rt {
  text-align: right;
  flex-shrink: 0;
}

.fi__rt b {
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-weight: 700;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
}

/* 类型标签 */
.tg {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
  vertical-align: 2rpx;
}

.tg--in {
  background: #ede6d8;
  color: var(--ink);
}

.tg--sell {
  background: var(--acs);
  color: var(--act);
}

.tg--owe {
  background: var(--wnb);
  color: var(--wn);
}

.tg--back {
  background: var(--vlb);
  color: var(--vl);
}

.tg--count {
  background: var(--ink);
  color: var(--sf);
}

.tg--pay {
  background: var(--okb);
  color: var(--ok);
}

.tg--waste {
  background: var(--dgrb);
  color: var(--dgr);
}

/* 主按钮 / 次按钮 */
.cta {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  min-height: 104rpx;
  border-radius: var(--r-btn);
  background: var(--ac);
  color: #fff;
  font-weight: 700;
  font-size: 30rpx;
  line-height: 1.35;
  text-align: center;
  padding: 16rpx 24rpx;
}

.cta:active {
  background: var(--act);
}

.cta--ink {
  background: var(--ink);
  color: var(--sf);
}

.btn-s {
  border: 2rpx solid var(--ink);
  border-radius: var(--r-pill);
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* 说话键（圆环） */
.ring-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  pointer-events: none;
  z-index: 20;
}

.ring {
  pointer-events: auto;
  width: 172rpx;
  height: 172rpx;
  border-radius: 50%;
  background: var(--ac);
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 28rpx;
  box-shadow: 0 0 0 24rpx #f3d2c0, 0 20rpx 40rpx -16rpx rgba(194, 65, 12, 0.6);
}

.ring--on {
  background: var(--ink);
  box-shadow: 0 0 0 28rpx #e3ddd0, 0 20rpx 40rpx -16rpx rgba(31, 27, 22, 0.5);
}

.ring__tip {
  font-size: 22rpx;
  color: var(--mu);
}

/* 底部提示条 */
.toast {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 240rpx;
  background: var(--ink);
  color: var(--sf);
  border-radius: 28rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 30;
  box-shadow: 0 20rpx 48rpx -20rpx rgba(0, 0, 0, 0.5);
}

.toast__tx {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.45;
}

.toast__btn {
  color: #fdba8c;
  font-weight: 700;
  font-size: 24rpx;
  white-space: nowrap;
  border: 2rpx solid #6b5f52;
  border-radius: var(--r-pill);
  padding: 8rpx 20rpx;
}

/* 空态 */
.empty {
  text-align: center;
  padding: 64rpx 32rpx;
  color: var(--mu);
  font-size: 26rpx;
}

/* 页面壳 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 16rpx 24rpx;
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.page__gap {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
}

/* 原生 button 自带宽度与居中，这里强制撑满（居中靠上面的 flex） */
button.cta {
  display: flex;
  width: 100%;
  margin: 0;
}

/* ==========================================================================
 * 兼容层：旧页面（manual / query / pay / admin）还在用 v1 类名。
 * 统一映射到新 token，避免一页新一页旧；后续逐页重写后删掉这一段。
 * ========================================================================== */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.panel {
  background: var(--sf);
  border: 2rpx solid var(--ln);
  border-radius: var(--r-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.panel__title,
.card__title {
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hint {
  font-size: 24rpx;
  color: var(--mu);
  line-height: 1.6;
}

.muted,
.tip,
.loading {
  color: var(--mu);
  font-size: 24rpx;
}

.error {
  background: var(--dgrb);
  border: 2rpx solid #e0b9b0;
  color: var(--dgr);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 26rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--ink);
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--ln);
}

.kv:last-child {
  border-bottom: none;
}

/* 按钮 */
.ui-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  line-height: normal;
  padding: 0 32rpx;
  border: none;
  border-radius: var(--r-btn);
  font-size: 30rpx;
  font-weight: 600;
}

.ui-btn::after {
  border: none;
}

.ui-btn--primary {
  background: var(--ac);
  color: #fff;
}

.ui-btn--ghost {
  background: var(--sf);
  color: var(--ink);
  border: 2rpx solid var(--ink);
}

.ui-btn--soft {
  background: var(--acs);
  color: var(--act);
}

.ui-btn--block {
  width: 100%;
  margin: 0;
}

/* 徽标 */
.ui-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: 22rpx;
}

.ui-badge--brand {
  background: var(--acs);
  color: var(--act);
}

.ui-badge--warn {
  background: var(--wnb);
  color: var(--wn);
}

.ui-badge--danger {
  background: var(--dgrb);
  color: var(--dgr);
}

/* 数字键（num-keyboard 组件用 .ui-key） */
.ui-key {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 104rpx;
  background: var(--bg);
  border: 2rpx solid var(--ln);
  border-radius: 18rpx;
  font-family: 'Songti SC', 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.ui-key--fn {
  background: #efe9dc;
  color: var(--mu);
}

.ui-key:active {
  background: var(--acs);
  border-color: var(--ac);
}

/* ==========================================================================
 * 旧组件（num-keyboard / impact-preview / slot-table / side-nav）仍读 v1 token 名，
 * 这里做别名，避免它们因为变量缺失退化成默认样式。
 * ========================================================================== */
page {
  --c-brand: var(--ac);
  --c-brand-light: var(--ac);
  --c-brand-dark: var(--act);
  --c-brand-soft: var(--acs);
  --c-accent: var(--wn);
  --c-accent-soft: var(--wnb);
  --c-ink: var(--ink);
  --c-ink-2: #4a443c;
  --c-ink-3: var(--mu);
  --c-bg: var(--bg);
  --c-white: var(--sf);
  --c-line: var(--ln);
  --c-warn-bg: var(--wnb);
  --c-warn-ink: var(--wn);
  --c-danger: var(--dgr);
  --c-danger-soft: var(--dgrb);
  --r-card: 28rpx;
  --r-btn: 24rpx;
  --r-pill: 999rpx;
  --s-1: 8rpx;
  --s-2: 16rpx;
  --s-3: 24rpx;
  --s-4: 32rpx;
  --f-small: 24rpx;
  --f-body: 28rpx;
  --f-title: 32rpx;
  --f-h1: 40rpx;
  --f-amount: 56rpx;
}

/* 通用桌面表头：手机端隐藏，宽屏（>=768px）显示 */
.dtbl-head {
  display: none;
}

/* ==========================================================================
 * 电脑版微信大屏自适应（min-width: 768px）
 * 解决 PC 端 rpx 放大失真，统一切为紧凑清晰的 px 桌面工作台尺度。
 * ========================================================================== */
@media (min-width: 768px) {
  page {
    font-size: 14px;
    line-height: 1.5;
  }

  .page {
    padding: 20px 28px 96px;
  }

  .page__gap {
    max-width: 1280px;
    margin: 0 auto;
    gap: 16px;
  }

  .card {
    border-width: 1px;
    border-radius: 14px;
  }

  .hello {
    gap: 12px;
  }

  .hello__t {
    font-size: 24px;
  }

  .hello__sub {
    font-size: 13px;
    margin-top: 4px;
  }

  .pbadge {
    border-width: 1px;
    padding: 6px 14px;
    font-size: 13px;
    gap: 8px;
    cursor: pointer;
  }

  .pbadge__n {
    min-width: 20px;
    height: 20px;
    font-size: 12px;
    padding: 0 6px;
  }

  .seg {
    padding: 4px;
  }

  .seg__item {
    font-size: 13px;
    padding: 7px 14px;
    cursor: pointer;
  }

  .stats {
    padding: 16px 8px;
  }

  .stats__i + .stats__i {
    border-left-width: 1px;
  }

  .stats__k {
    font-size: 12px;
  }

  .stats__v {
    font-size: 24px;
    margin-top: 4px;
  }

  .bar {
    padding: 12px 16px;
    border-radius: 12px;
    border-width: 1px;
    font-size: 13px;
    gap: 12px;
  }

  .flow {
    padding: 4px 20px 10px;
  }

  .flow__h {
    font-size: 12px;
    padding: 14px 0 8px;
  }

  .fi {
    gap: 12px;
    padding: 12px 0;
    border-top-width: 1px;
    cursor: pointer;
  }

  .fi__tm {
    font-size: 12px;
    width: 64px;
    padding-top: 2px;
  }

  .fi__md b {
    font-size: 14px;
  }

  .fi__md small {
    font-size: 12px;
    margin-top: 2px;
  }

  .fi__rt b {
    font-size: 15px;
  }

  .tg {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 6px;
    margin-right: 8px;
    vertical-align: 1px;
  }

  .cta {
    min-height: 46px;
    border-radius: 12px;
    font-size: 15px;
    padding: 10px 18px;
    cursor: pointer;
  }

  .btn-s {
    border-width: 1px;
    padding: 6px 14px;
    font-size: 13px;
    cursor: pointer;
  }

  .empty {
    padding: 40px 20px;
    font-size: 14px;
  }

  .dtbl-head {
    display: grid;
    align-items: center;
    background: #f7f3ea;
    color: var(--mu);
    font-size: 12px;
    font-weight: 600;
    border-bottom: 1px solid var(--ln);
    padding: 10px 20px;
  }
}

/* ==========================================================================
 * Style D 语义彩标图标系统（纯本地 base64 SVG，兼容手机端与电脑版微信）
 * ========================================================================== */
.bar__lead {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.ico-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ico-badge--sm {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
}

.ico-badge--ac {
  background: var(--acs);
}

.ico-badge--ok {
  background: var(--okb);
}

.ico-badge--wn {
  background: var(--wnb);
}

.ico-badge--vl {
  background: var(--vlb);
}

.ico-badge--dgr {
  background: var(--dgrb);
}

.ico {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.ico--sm {
  width: 28rpx;
  height: 28rpx;
}

.ico--btn {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

