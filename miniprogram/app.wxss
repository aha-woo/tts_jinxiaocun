/* 全局样式：面向 45~50 岁用户，字号偏大、点击热区偏大 */
page {
  background: #f4f6f8;
  color: #1b1f24;
  font-size: 32rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

/* 电脑版微信大屏：resizable 生效后宽度变大，用双栏承载管理页内容 */
.wide-layout {
  display: flex;
  flex-direction: row;
  gap: 32rpx;
  align-items: flex-start;
}

.wide-layout__main {
  flex: 1 1 62%;
  min-width: 0;
}

.wide-layout__side {
  flex: 1 1 38%;
  min-width: 0;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(16, 24, 40, 0.06);
}

.card__title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.card__row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 30rpx;
  color: #3d4550;
}

.card__value {
  font-weight: 600;
  color: #1b1f24;
}

.text-ok {
  color: #0f9d58;
}

.text-warn {
  color: #b26a00;
}

.text-danger {
  color: #d93025;
}

.muted {
  color: #6b7280;
  font-size: 26rpx;
}

/* 主按钮：热区 >= 88x88px（PRD 3.2 假设） */
.btn-primary {
  min-height: 88px;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1f6feb;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  min-height: 88px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #1f6feb;
  border: 2rpx solid #1f6feb;
  border-radius: 16rpx;
  font-size: 30rpx;
}
