# 依赖与虚拟环境
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# 本地配置与密钥（.env.example 入库，.env 不入库）
.env
.env.local
project.private.config.json

# 仓库根目录的开发者工具配置：本项目的小程序工程根是 miniprogram/，
# 根目录一旦被微信开发者工具打开就会自动吐出一份 useCompilerPlugins:false 的
# 配置，把 TypeScript 编译插件关掉、指向错误的工程根。它不该存在，也不该入库。
/project.config.json

# 构建与测试产物
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
htmlcov/
.coverage

# 本地数据库与离线渲染产物（T02：本地 SQLite 冒烟库 / alembic --sql 输出）
*.db
*.sqlite
*.sqlite3
server/_schema.sql

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

