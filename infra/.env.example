# ---------------------------------------------------------------------------
# 本地/云托管环境变量模板。**复制为 .env 后填写真实值，.env 不入库。**
# 云托管在「服务设置 → 环境变量」里配置同名变量；容器不持久化、不内置任何密钥。
# ---------------------------------------------------------------------------

# ---- 基础 ----
APP_ENV=local                 # local | test | prod（prod 时关闭 /docs 与 /openapi.json）
LOG_LEVEL=INFO
# 共享契约目录：容器内为 /app/packages/shared（镜像已 COPY），本地默认自动定位仓库
CONTRACTS_DIR=

# ---- 幂等键 ----
IDEMPOTENCY_TTL_SECONDS=60
IDEMPOTENCY_MAX_ENTRIES=2048
# 外挂托管 Redis（云托管不部署有状态服务）。留空 = 自动降级内存 LRU
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=vil:idem

# ---- 数据库（T02 接入，外挂托管 PostgreSQL + RLS）----
DATABASE_URL=postgresql+psycopg://vil:vil_local_only@127.0.0.1:5432/vil

# ---- 微信登录 / 鉴权（T02）----
WX_APPID=
WX_APP_SECRET=
JWT_SECRET=                  # 请用 32 字节以上随机串
JWT_EXPIRE_SECONDS=7200

# ---- 微信云托管 ----
CLOUD_HOST_ENV=              # 云开发环境 id（与小程序 services/api.ts 的 CLOUD_ENV 一致）
CLOUD_SERVICE_NAME=voice-inventory-api
# callContainer 请求体上限 100K（音频只传引用，见 D11）
MAX_REQUEST_BODY_BYTES=102400

# ---- ASR / LLM（T03；型号与价格**禁止写死**，全部走这里）----
ASR_PROVIDER=
ASR_APP_KEY=
ASR_TIMEOUT_MS=3000
LLM_PROVIDER=
LLM_API_KEY=
LLM_PRIMARY_MODEL=
LLM_LITE_MODEL=
LLM_TIMEOUT_MS=3000

# ---- 虚拟支付（T04；现网 Key，沙箱 Key 不得用于生产）----
XPAY_APP_KEY=
XPAY_MCH_ID=
# 发货唯一路径 = 云函数 xpay_deliver_notify → 云托管 /api/v1/entitlement/deliver-callback（内网）
DELIVER_CALLBACK_URL=
# 服务间令牌：云函数（请求头 X-Service-Token）与云托管（本变量）**必须是同一个值**。
# 未配置时发货端点直接 503 + ERROR 告警（**不默认放行**）；令牌不匹配/通道不是云函数 → 403。
# 生成建议：openssl rand -hex 32
SERVICE_TOKEN=

# ---- 对象存储（音频临时直传 / 导出文件）----
STORAGE_BUCKET=
STORAGE_PREFIX_TEMPLATE=t/{tenant_id}/
UPLOAD_TICKET_TTL_SECONDS=300

# ---- 租户与时区 ----
TENANT_DEFAULT_TZ=Asia/Shanghai

# ---- 业务阈值（均为**假设，需核实**）----
REVERSAL_WINDOW_MINUTES=10
CARD_TTL_SECONDS=30
CANCEL_VOICE_WINDOW_SECONDS=15
WRITEOFF_R3_THRESHOLD_FEN=50000   # 抹零核销超过该金额升 R3（仅电脑版微信大屏审批）
