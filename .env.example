# ==============================================================================
# 语音录入版轻量化进销存 · 服务端环境变量模板
# 复制为 .env 后填入真实密钥；ENV=production 时假模型/默认密钥会在启动期被拒绝。
# ==============================================================================

APP_ENV=local
HOST=0.0.0.0
PORT=8080

# --- 数据库（生产必须 PostgreSQL + RLS，例：postgresql+psycopg://...）---
DATABASE_URL=sqlite+pysqlite:///./data/dev.db

# --- Redis（用于配额限流与分布式幂等；留空则单进程内存兜底）---
REDIS_URL=

# --- 鉴权与微信支付回调 ---
JWT_SECRET=change-me-to-at-least-32-random-bytes-in-production
WX_PROVIDER=real
WX_APPID=
WX_APP_SECRET=
SERVICE_TOKEN=change-me-service-token

# ==============================================================================
# 中国开源文字解析大模型（G4 兜底通道 + 双路故障转移 + 强模型重试）
# 可选平台（均兼容 OpenAI Chat Completions）：
#   1. 硅基流动 SiliconFlow:
#      LLM_VENDOR=openai_compat
#      LLM_BASE_URL=https://api.siliconflow.cn/v1
#      LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#      LLM_STRONG_MODEL=Qwen/Qwen2.5-32B-Instruct
#   2. 阿里百炼 Bailian (DashScope):
#      LLM_VENDOR=bailian
#      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#      LLM_MODEL=qwen-turbo
#      LLM_STRONG_MODEL=qwen-plus
#   3. DeepSeek / 智谱 (备路可混配不同供应商):
#      LLM_BACKUP_BASE_URL=https://api.deepseek.com/v1
#      LLM_BACKUP_MODEL=deepseek-chat
# ==============================================================================
LLM_PROVIDER=fake
LLM_VENDOR=openai_compat
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_STRONG_MODEL=Qwen/Qwen2.5-32B-Instruct
LLM_API_KEY=
LLM_BACKUP_BASE_URL=https://api.deepseek.com/v1
LLM_BACKUP_MODEL=deepseek-chat
LLM_BACKUP_API_KEY=
LLM_TIMEOUT_SECONDS=6
LLM_MAX_TOKENS=1024

# ==============================================================================
# 中国开源多模态视觉模型（M2 拍进货单识别）
# 可选平台：
#   - 硅基流动: VISION_BASE_URL=https://api.siliconflow.cn/v1
#               VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
#   - 阿里百炼: VISION_VENDOR=bailian, VISION_MODEL=qwen2.5-vl-72b-instruct
#   - 智谱开放: VISION_MODEL=glm-4v-flash / glm-4v-plus
# ==============================================================================
VISION_PROVIDER=fake
VISION_VENDOR=openai_compat
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=20
